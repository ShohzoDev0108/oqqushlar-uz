msgid "Ulashing"
msgstr ""

#: taklif/templates/taklif/bosh_sahifa.html:275
msgid ""
"Tayyor taklifnomani ko'rib chiqing, yoqsa faollashtiring va yaqinlaringizga "
"Telegram yoki Instagram orqali yuboring."
msgstr ""

