#: taklif/forms.py:28
msgid "Taklifnoma manzili (link)"
msgstr "Invitation address (link)"

#: taklif/forms.py:31
msgid ""
"Faqat qisqa nom yozing, masalan: ollomurod-kamola — \"sayt.uz\" yoki \"/\" "
"belgisini yozmang, buni tizim o'zi qo'shadi."
msgstr ""
"Write only a short name, e.g.: ollomurod-kamola — don't type \"sayt.uz\" or "
"\"/\", the system adds that itself."

#: taklif/forms.py:37
msgid "Marosim turi"
msgstr "Event type"

#: taklif/forms.py:42
msgid "Tayyor musiqalardan tanlash (ixtiyoriy)"
msgstr "Choose from preset music (optional)"

#: taklif/forms.py:45
msgid "— tanlanmagan —"
msgstr "— not selected —"

#: taklif/forms.py:73
msgid "1-ism (masalan: kuyov, tug'ilgan kun egasi)"
msgstr "Name 1 (e.g. groom, birthday person)"

#: taklif/forms.py:74
msgid "2-ism (ixtiyoriy, masalan: kelin)"
msgstr "Name 2 (optional, e.g. bride)"

#: taklif/forms.py:75 taklif/forms.py:88
msgid "Tadbir sanasi va vaqti"
msgstr "Event date and time"

#: taklif/forms.py:76
msgid "To'yxona/manzil nomi"
msgstr "Venue name"

