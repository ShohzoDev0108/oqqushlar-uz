msgid "Masalan: Do'kon ochilishi, Bitiruv kechasi"
msgstr "Масалан: Кушоиши мағоза, Шаби хатми таҳсил"

msgid "Masalan: “Poytaxt” to'yxonasi"
msgstr "Масалан: толори тӯйхонаи \"Пойтахт\""

msgid "Masalan: Toshkent sh., Chilonzor tumani, Bunyodkor ko'chasi 12"
msgstr "Масалан: ш. Тошкент, ноҳияи Чилонзор, кӯчаи Бунёдкор 12"

msgid "Masalan: rasmiy kiyim, och ranglar"
msgstr "Масалан: либоси расмӣ, рангҳои равшан"

msgid ""
"Masalan: Sizlarsiz bu kun to'liq bo'lmaydi — quvonchimizga sherik "
"bo'lishingizni astoydil kutamiz"
msgstr ""
"Масалан: Ин рӯз бе шумо пурра нахоҳад буд — аз таҳи дил интизори он ҳастем, "
"ки дар шодии мо шарик шавед"

msgid "Tadbir nomi"
msgstr "Номи чорабинӣ"

msgid "Tadbir sanasi va vaqti"
msgstr "Сана ва вақти чорабинӣ"

msgid "To'yxona/manzil nomi"
msgstr "Номи толор/ҷой"

msgid "Manzil"
msgstr "Суроға"

msgid "Xarita havolasi (ixtiyoriy)"
msgstr "Пайванди харита (ихтиёрӣ)"

msgid "Kiyinish kodi (ixtiyoriy)"
msgstr "Кодекси либос (ихтиёрӣ)"

msgid "O'zingiz musiqa yuklash (ixtiyoriy)"
msgstr "Мусиқии худро бор кунед (ихтиёрӣ)"

msgid "Mehmonlarga atalgan so'zingiz (ixtiyoriy)"
msgstr "Суханони шумо ба меҳмонон (ихтиёрӣ)"

msgid "Sovg'a-pul uchun karta raqami (ixtiyoriy)"
msgstr "Рақами корт барои тӯҳфаи пулӣ (ихтиёрӣ)"

msgid "Mehmonlar uchun Telegram guruhi (ixtiyoriy)"
msgstr "Гурӯҳи Telegram барои меҳмонон (ихтиёрӣ)"

msgid ""
"Taklifnomangiz sayt bosh sahifasida namuna sifatida boshqa mijozlarga "
"ko'rsatilishiga rozimisiz?"
msgstr ""
"Оё шумо розӣ ҳастед, ки даъватномаи шумо ҳамчун намуна дар саҳифаи асосии "
"сайт ба дигар муштариён нишон дода шавад?"

msgid "Marosim turini ro'yxatda topa olmasangiz shu yerga o'zingiz yozing."
msgstr "Агар навъи чорабиниро дар рӯйхат наёбед, худатон дар ин ҷо нависед."

msgid "Taklifnomada mehmonlarga to'g'ridan-to'g'ri shu matn ko'rsatiladi."
msgstr "Ин матн дар даъватнома бевосита ба меҳмонон нишон дода мешавад."

msgid "O'zingiz yuklamoqchi bo'lsangiz"
msgstr "Агар хоҳед файли худро бор кунед"

msgid ""
"Ixtiyoriy. Belgilamasangiz ham taklifnomangiz odatdagidek ishlayveradi — bu "
"faqat bosh sahifadagi namunalar ro'yxatiga tegishli."
msgstr ""
"Ихтиёрӣ. Агар қайд накунед ҳам, даъватномаи шумо мисли пештара кор мекунад —"
" ин танҳо ба рӯйхати намунаҳо дар саҳифаи асосӣ дахл дорад."

msgid "Bu marosim turi uchun ikkinchi ismni ham kiriting."
msgstr "Барои ин навъи маросим номи дуюмро низ ворид кунед."

msgid "Nikoh to'yi"
msgstr "Тӯйи никоҳ"

msgid "Qiz uzatish"
msgstr "Гусели арӯс"

msgid "Sunnat to'yi"
msgstr "Ҷашни суннатӣ"

msgid "Beshik to'yi"
msgstr "Тӯйи гаҳвора"

msgid "Nahor oshi"
msgstr "Оши наҳор"

msgid "Yubiley"
msgstr "Солгард"

msgid "Tug'ilgan kun"
msgstr "Рӯзи таваллуд"

msgid "Boshqa"
msgstr "Дигар"

msgid "Zamonaviy"
msgstr "Муосир"

msgid "Milliy"
msgstr "Миллӣ"

msgid "Bolalar"
msgstr "Кӯдакона"

