msgid "Marosim turi"
msgstr "Навъи маросим"

msgid "Tayyor musiqalardan tanlash (ixtiyoriy)"
msgstr "Аз мусиқии тайёр интихоб кунед (ихтиёрӣ)"

msgid "— tanlanmagan —"
msgstr "— интихоб нашудааст —"

msgid "1-ism (masalan: kuyov, tug'ilgan kun egasi)"
msgstr "Номи 1 (масалан: домод, соҳиби ҷашн)"

msgid "2-ism (ixtiyoriy, masalan: kelin)"
msgstr "Номи 2 (ихтиёрӣ, масалан: арӯс)"

msgid "Tadbir sanasi va vaqti"
msgstr "Сана ва вақти чорабинӣ"

msgid "To'yxona/manzil nomi"
msgstr "Номи толор/ҷой"

msgid "Manzil"
msgstr "Суроға"

msgid "Xarita havolasi (ixtiyoriy)"
msgstr "Пайванди харита (ихтиёрӣ)"

msgid "Kiyinish kodi (ixtiyoriy)"
msgstr "Кодекси либос (ихтиёрӣ)"

msgid "O'zingiz musiqa yuklash (ixtiyoriy)"
msgstr "Мусиқии худро бор кунед (ихтиёрӣ)"

msgid "Qo'shimcha tabrik matni (ixtiyoriy)"
msgstr "Матни иловагии табрик (ихтиёрӣ)"

msgid "Sovg'a-pul uchun karta raqami (ixtiyoriy)"
msgstr "Рақами корт барои тӯҳфаи пулӣ (ихтиёрӣ)"

msgid "Mehmonlar uchun Telegram guruhi (ixtiyoriy)"
msgstr "Гурӯҳи Telegram барои меҳмонон (ихтиёрӣ)"

msgid ""
"Taklifnomangiz sayt bosh sahifasida namuna sifatida boshqa mijozlarga "
"ko'rsatilishiga rozimisiz?"
msgstr ""
"Оё шумо розӣ ҳастед, ки даъватномаи шумо ҳамчун намуна дар саҳифаи асосии "
"сайт ба дигар муштариён нишон дода шавад?"

msgid "Masalan: kuyov, tug'ilgan kun egasi"
msgstr "Масалан: домод, соҳиби ҷашн"

msgid "Ikkinchi ism (masalan: kelin). Kerak bo'lmasa bo'sh qoldiring"
msgstr "Номи дуюм (масалан: арӯс). Агар лозим набошад, холӣ монед"

msgid "Masalan: rasmiy, yorug' ranglar"
msgstr "Масалан: расмӣ, рангҳои равшан"

msgid "O'zingiz yuklamoqchi bo'lsangiz"
msgstr "Агар хоҳед файли худро бор кунед"

msgid "Qo'shimcha tabrik/taklif matni"
msgstr "Матни иловагии табрик/даъват"

msgid "Pul sovg'a uchun karta raqami"
msgstr "Рақами корт барои тӯҳфаи пулӣ"

msgid "Mehmonlar uchun Telegram guruh/kanal havolasi"
msgstr "Пайванди гурӯҳ/канали Telegram барои меҳмонон"

msgid ""
"Ixtiyoriy. Yoqmasangiz ham taklifnomangiz odatdagidek ishlayveradi — bu "
"faqat bosh sahifadagi namunalar ro'yxatiga tegishli."
msgstr ""
"Ихтиёрӣ. Агар фаъол накунед ҳам, даъватномаи шумо мисли пештара кор мекунад "
"— ин танҳо ба рӯйхати намунаҳо дар саҳифаи асосӣ дахл дорад."

msgid "Bu marosim turi uchun ikkinchi ismni ham kiriting."
msgstr "Барои ин навъи маросим номи дуюмро низ ворид кунед."

msgid "Nikoh to'yi"
msgstr "Тӯйи никоҳ"

msgid "Qiz uzatish"
msgstr "Гусели арӯс"

msgid "Sunnat to'yi"
msgstr "Ҷашни суннатӣ"

msgid "Beshik to'yi"
msgstr "Тӯйи гаҳвора"

msgid "Nahor oshi"
msgstr "Оши наҳор"

msgid "Yubiley"
msgstr "Солгард"

msgid "Tug'ilgan kun"
msgstr "Рӯзи таваллуд"

msgid "Boshqa"
msgstr "Дигар"

msgid "Zamonaviy"
msgstr "Муосир"

msgid "Milliy"
msgstr "Миллӣ"

msgid "Bolalar"
msgstr "Кӯдакона"

msgid "Dizaynlar"
msgstr "Дизайнҳо"

msgid "Mening taklifnomalarim"
msgstr "Даъватномаҳои ман"

msgid "Musiqani yoqish/o'chirish"
msgstr "Мусиқиро фаъол/ғайрифаъол кунед"

msgid "Taklifnoma yaratish"
msgstr "Даъватнома сохтан"

msgid "Tilni tanlang"
msgstr "Забонро интихоб кунед"

msgid "chiroyli raqamli taklifnomalar"
msgstr "даъватномаҳои зебои рақамӣ"

msgid "Eng go'zal kuningiz uchun"
msgstr "Барои зеботарин рӯзи шумо"

msgid "raqamli taklifnoma"
msgstr "даъватномаи рақамӣ"

msgid "Tez va oson"
msgstr "Зуд ва осон"

msgid "Telefonda o'zingiz yarating"
msgstr "Худатон дар телефон созед"

msgid ""
"Dizaynni tanlang, ma'lumotlaringizni kiriting va tayyor taklifnomani shu "
"zahoti ko'ring — bor-yo'g'i 5 daqiqada, ro'yxatdan o'tmasdan. To'lov — faqat"
" yoqqanidan keyin."
msgstr ""
"Тарҳро интихоб кунед, маълумотро ворид кунед ва даъватномаи тайёрро дарҳол "
"бинед — ҳамагӣ дар 5 дақиқа, бе сабти ном. Пардохт — танҳо агар маъқул "
"шавад."

msgid "Barcha dizaynlarni ko'rish"
msgstr "Дидани ҳамаи дизайнҳо"

msgid "So'nggi taklifnomalar"
msgstr "Даъватномаҳои охирин"

msgid "Platformamizda faollashtirilgan taklifnomalardan namunalar"
msgstr "Намунаҳои даъватномаҳои фаъолшуда дар платформаи мо"

msgid "Qanday ishlaydi?"
msgstr "Чӣ тавр кор мекунад?"

msgid "Uch oddiy qadam — va taklifnomangiz tayyor"
msgstr "Се қадами оддӣ — ва даъватномаи шумо тайёр"

msgid "Dizayn tanlang"
msgstr "Дизайн интихоб кунед"

msgid ""
"Bir nechta tayyor shablondan o'zingizga yoqqanini tanlang — har biri o'ziga "
"xos uslubda."
msgstr ""
"Аз якчанд шаблонҳои тайёр маъқулатонро интихоб кунед — ҳар яке услуби хос "
"дорад."

msgid "Ma'lumotlarni to'ldiring"
msgstr "Маълумотро пур кунед"

msgid ""
"Marosim turi, ismlar, sana, manzil, rasmlar va musiqa — hammasini o'zingiz "
"kiritasiz."
msgstr ""
"Навъи маросим, номҳо, сана, суроға, расмҳо ва мусиқӣ — ҳамаро худатон ворид "
"мекунед."

msgid "Ulashing"
msgstr "Мубодила кунед"

msgid ""
"Tayyor taklifnomani ko'rib chiqing, yoqsa faollashtiring va yaqinlaringizga "
"Telegram yoki Instagram orqali yuboring."
msgstr ""
"Даъватномаи тайёрро бинед, агар маъқул шавад, фаъол кунед ва ба наздиконатон"
" тавассути Telegram ё Instagram фиристед."

msgid "Dizayn shablonlari"
msgstr "Шаблонҳои дизайн"

msgid "Tanlang va shu zahoti o'zingiznikini yaratib ko'ring"
msgstr "Интихоб кунед ва дарҳол аз они худро созед"

msgid "Barchasi"
msgstr "Ҳама"

msgid "so'm"
msgstr "сум"

msgid "Bosh sahifa"
msgstr "Саҳифаи асосӣ"

msgid ""
"Bu ro'yxat sizning shu brauzerda yaratgan barcha taklifnomalaringizni "
"ko'rsatadi — ularni solishtirib, eng yoqqanini tanlashingiz mumkin."
msgstr ""
"Ин рӯйхат ҳамаи даъватномаҳоеро, ки шумо дар ин браузер сохтаед, нишон "
"медиҳад — онҳоро муқоиса карда, беҳтаринашро интихоб кунед."

msgid "Yana bitta yaratish"
msgstr "Боз як сохтан"

msgid "Faollashtirilgan"
msgstr "Фаъолшуда"

msgid "To'lov kutilmoqda"
msgstr "Пардохт интизор аст"

msgid "Ko'rish"
msgstr "Дидан"

msgid "Yoqdi"
msgstr "Маъқул шуд"

msgid ""
"DIQQAT: bu taklifnoma FAOLLASHTIRILGAN — mehmonlarga yuborilgan va RSVP "
"javoblari bo'lishi mumkin! O'chirilsa, darhol ko'rinmay qoladi (30 kun "
"ichida administratorga murojaat qilib tiklash mumkin). Rostdan ham davom "
"etasizmi?"
msgstr ""
"ДИҚҚАТ: ин даъватнома ФАЪОЛ КАРДА ШУДААСТ — мумкин ба меҳмонон фиристода "
"шуда бошад ва посухҳои RSVP дошта бошад! Агар нест карда шавад, дарҳол "
"нопадид мешавад (дар давоми 30 рӯз метавонед ба администратор муроҷиат карда"
" барқарор кунед). Ҳақиқатан идома медиҳед?"

msgid ""
"Rostdan ham ushbu taklifnomani butunlay o'chirmoqchimisiz? Bu amalni ortga "
"qaytarib bo'lmaydi."
msgstr ""
"Ҳақиқатан мехоҳед ин даъватномаро комилан нест кунед? Ин амалро "
"бозгардонидан мумкин нест."

msgid "O'chirish"
msgstr "Нест кардан"

msgid "Siz hali hech qanday taklifnoma yaratmagansiz."
msgstr "Шумо ҳоло ягон даъватнома насохтаед."

msgid "Taklifnoma yopilgan"
msgstr "Даъватнома баста аст"

msgid "Ushbu taklifnoma sahifasi yopilgan"
msgstr "Ин саҳифаи даъватнома баста аст"

#, python-format
msgid "%(nomi)s bilan bog'liq sahifa endi faol emas."
msgstr "Саҳифаи марбут ба %(nomi)s дигар фаъол нест."

msgid "Shablon tanlang"
msgstr "Шаблон интихоб кунед"

msgid ""
"Sizga yoqqan dizaynni tanlang — keyingi bosqichda o'z ma'lumotlaringizni "
"to'ldirasiz."
msgstr ""
"Дизайни маъқулатонро интихоб кунед — дар қадами оянда маълумоти худро пур "
"мекунед."

msgid "Hozircha shablon yo'q. Admin panelda qo'shing."
msgstr "Ҳоло шаблон нест. Дар панели админ илова кунед."

msgid "kun"
msgstr "рӯз"

msgid "soat"
msgstr "соат"

msgid "minut"
msgstr "дақиқа"

msgid "sekund"
msgstr "сония"

msgid "Marosim kalendari"
msgstr "Тақвими маросим"

msgid "Du Se Ch Pa Ju Sh Ya"
msgstr "Дш Сш Чш Пш Ҷм Шб Яш"

msgid "Fotolavha"
msgstr "Расмҳо"

msgid "Tadbir tafsilotlari"
msgstr "Тафсилоти чорабинӣ"

msgid "Sana"
msgstr "Сана"

msgid "Vaqt"
msgstr "Вақт"

msgid "To'yxona"
msgstr "Толори тӯй"

msgid "Kiyinish kodi"
msgstr "Кодекси либос"

msgid "Tabrik sovg'asi"
msgstr "Тӯҳфа"

msgid ""
"Ishtirokingiz — biz uchun eng qadrli sovg'a. Agar tabrik sovg'a qoldirmoqchi"
" bo'lsangiz:"
msgstr ""
"Ҳузури шумо — тӯҳфаи пурарзиштарин барои мост. Агар хоҳед тӯҳфаи пулӣ "
"гузоред:"

msgid "Nusxalandi!"
msgstr "Нусха бардошта шуд!"

msgid "RSVP — kelasizmi?"
msgstr "RSVP — меоед?"

msgid "Ismingiz"
msgstr "Номи шумо"

msgid "Nechta kishi bo'lasiz?"
msgstr "Чанд нафар мешавед?"

msgid "1 dan 5 gacha"
msgstr "Аз 1 то 5"

msgid "Kelasizmi?"
msgstr "Меоед?"

msgid "Ha, albatta kelaman"
msgstr "Ҳа, ҳатман меоям"

msgid "Afsuski, kela olmayman"
msgstr "Мутаассифона, наметавонам биёям"

msgid "Izoh (ixtiyoriy)"
msgstr "Шарҳ (ихтиёрӣ)"

msgid "Yuborish"
msgstr "Фиристодан"

msgid "Mehmonlar"
msgstr "Меҳмонон"

#, python-format
msgid "Hozircha <strong>%(soni)s</strong> kishi kelishini tasdiqladi"
msgstr "То ҳол <strong>%(soni)s</strong> нафар омаданашонро тасдиқ карданд"

#, python-format
msgid "%(soni)s kishi"
msgstr "%(soni)s нафар"

msgid "Yangiliklar va suratlar uchun Telegram guruhimizga qo'shiling"
msgstr "Ба гурӯҳи Telegram мо барои хабарҳо ва расмҳо ҳамроҳ шавед"

msgid "Telegram guruhi"
msgstr "Гурӯҳи Telegram"

msgid "Do'stlaringizga ulashing"
msgstr "Ба дӯстон фиристед"

msgid "Taklifnomani yaqinlaringizga ham yuboring"
msgstr "Даъватномаро ба наздиконатон ҳам фиристед"

msgid "Havolani nusxalash"
msgstr "Пайвандро нусха кунед"

#, python-format
msgid "Hurmatli %(ism)s, sizga taklifnoma keldi"
msgstr "Мӯҳтарам %(ism)s, барои шумо даъватнома омад"

msgid "Sizga taklifnoma keldi"
msgstr "Барои шумо даъватнома омад"

msgid "Taklifnomani ochish"
msgstr "Даъватномаро кушоед"

msgid "Bu — sizning shaxsiy oldindan ko'rish havolangiz, hali ommaviy emas."
msgstr "Ин пайванди пешнамоиши шахсии шумост, ҳанӯз оммавӣ нест."

msgid "Faollashtirish uchun Telegram orqali"
msgstr "Барои фаъол кардан бо мо тавассути Telegram"

msgid "bilan bog'laning."
msgstr "тамос гиред."

msgid "Yoqdi (yuborildi)"
msgstr "Маъқул шуд (фиристода шуд)"

msgid "Yoqdi — adminga yozish"
msgstr "Маъқул шуд — ба админ нависед"

msgid "Qayta yaratish"
msgstr "Аз нав созед"

msgid "Baxtli oilamizga"
msgstr "Аз лаҳзаи ҷашни мо гузашт"

msgid "yil"
msgstr "сол"

msgid "bo'ldi"
msgstr " "

msgid "Marosimgacha"
msgstr "То чорабинӣ"

msgid "taklifnomasi"
msgstr "даъватнома"

msgid "Statistika"
msgstr "Омор"

msgid "Ochiq sahifani ko'rish"
msgstr "Дидани даъватнома"

#, python-format
msgid "%(nomi)s — statistika"
msgstr "%(nomi)s — омор"

msgid "Bu sahifa faqat sizga ko'rinadi. Linkni hech kimga yubormang."
msgstr "Ин саҳифа танҳо ба шумо намоён аст. Линкро ба ҳеҷ кас нафиристед."

msgid "ko'rishlar"
msgstr "дидашавӣ"

msgid "javoblar"
msgstr "ҷавобҳо"

msgid "keladi (mehmon)"
msgstr "меоянд (меҳмон)"

msgid "kelmaydi"
msgstr "намеоянд"

msgid "Ism"
msgstr "Ном"

msgid "Holat"
msgstr "Ҳолат"

msgid "Mehmonlar soni"
msgstr "Шумораи меҳмонон"

msgid "Izoh"
msgstr "Изоҳ"

msgid "Keladi"
msgstr "Меояд"

msgid "Kelmaydi"
msgstr "Намеояд"

msgid "Hozircha javoblar yo'q."
msgstr "Ҳоло ҷавобе нест."

msgid "Mehmonlar uchun shaxsiy linklar"
msgstr "Линкҳои шахсӣ барои меҳмонон"

msgid ""
"Admin panelda qo'shilgan har bir mehmonga shaxsiy link — shu linkni "
"Telegram/Instagram orqali o'sha mehmonning o'ziga yuboring."
msgstr ""
"Барои ҳар меҳмоне, ки дар панели идора илова шудааст, линки шахсӣ — ин "
"линкро тавассути Telegram/Instagram ба худи ҳамон меҳмон фиристед."

msgid "Ko'rdimi"
msgstr "Дидааст?"

msgid "Link"
msgstr "Линк"

msgid "ko'rdi"
msgstr "дид"

msgid "hali ko'rmagan"
msgstr "ҳанӯз надидааст"

msgid ""
"Hali mehmon qo'shilmagan. Admin panelda taklifnoma ichida \"Mehmonlar\" "
"bo'limidan qo'shing."
msgstr ""
"Ҳанӯз меҳмон илова нашудааст. Онҳоро аз бахши «Меҳмонон» дар дохили "
"таклифнома дар панели идора илова кунед."

msgid "Tayyor!"
msgstr "Тайёр!"

msgid "Taklifnomangiz tayyor!"
msgstr "Даъватномаи шумо тайёр!"

msgid "Bu — sizning shaxsiy havolangiz. Mehmonlaringizga shuni yuborasiz:"
msgstr "Ин — пайванди шахсии шумост. Онро ба меҳмонони худ фиристед:"

msgid "Nusxalash"
msgstr "Нусхабардорӣ"

msgid "Taklifnomani ko'rish"
msgstr "Дидани даъватнома"

msgid ""
"Yuqoridagi tugma orqali taklifnomangizni ko'rib, hammasi to'g'ri ekanligiga "
"ishonch hosil qiling."
msgstr ""
"Тавассути тугмаи боло даъватномаро бинед ва боварӣ ҳосил кунед, ки ҳамааш "
"дуруст аст."

#, python-format
msgid ""
"Yoqsa — taklifnoma sahifasidagi <strong>\"Yoqdi\"</strong> tugmasini bosing,"
" shu orqali to'g'ridan-to'g'ri Telegram orqali <strong>%(admin)s</strong> "
"bilan bog'lanib to'lovni amalga oshirasiz."
msgstr ""
"Агар маъқул шавад — тугмаи <strong>«Маъқул шуд»</strong>-ро дар саҳифаи "
"даъватнома пахш кунед: ҳамин тавр мустақиман дар Telegram бо "
"<strong>%(admin)s</strong> тамос гирифта, пардохт мекунед."

msgid ""
"To'lov tasdiqlangach, taklifnomangiz faollashtiriladi va uni "
"mehmonlaringizga (Telegram, Instagram va h.k.) yuborishingiz mumkin bo'ladi."
msgstr ""
"Пас аз тасдиқи пардохт даъватномаатон фаъол мешавад ва шумо метавонед онро "
"ба меҳмонон фиристед (Telegram, Instagram ва ғ.)."

msgid "shabloni"
msgstr "шаблон"

msgid ""
"Ma'lumotlaringizni to'ldiring. Yuborgach — taklifnomangiz shu zahoti tayyor "
"bo'ladi (hali hech kimga ochiq emas)."
msgstr ""
"Маълумоти худро пур кунед. Пас аз ирсол, таклифномаи шумо дарҳол тайёр "
"мешавад (то ҳол ба ҳеҷ кас намоён нест)."

#, python-format
msgid ""
"Sizda <strong>%(ism1)s %(ism2)s</strong> nomi bilan taklifnoma allaqachon "
"bor (shu brauzerda avval yaratilgan)."
msgstr ""
"Шумо аллакай бо номҳои <strong>%(ism1)s %(ism2)s</strong> таклифнома доред "
"(қаблан дар ҳамин браузер сохта шудааст)."

msgid "Nima qilamiz?"
msgstr "Чӣ кор кунем?"

msgid "Buni yangilayman (eskisi o'chadi)"
msgstr "Инро навсозӣ мекунам (кӯҳнааш нест мешавад)"

msgid "Yo'q, alohida saqlayman"
msgstr "Не, алоҳида нигоҳ медорам"

#, python-format
msgid "Rasmlar (eng ko'pi bilan %(soni)s ta, ixtiyoriy)"
msgstr "Расмҳо (на бештар аз %(soni)s дона, ихтиёрӣ)"

msgid "O'z fotoyingiz hali bo'lmasa, tayyor namunalardan tanlashingiz mumkin:"
msgstr ""
"Агар шумо ҳанӯз акси худро надошта бошед, метавонед аз намунаҳои тайёр "
"интихоб кунед:"

#, python-format
msgid "Namuna rasm %(soni)s"
msgstr "Акси намуна %(soni)s"

msgid "yoki"
msgstr "ё"

msgid "O'zingizning rasmingizni yuklang"
msgstr "Акси худро бор кунед"

msgid "Taklifnomani yaratish"
msgstr "Даъватномаро сохтан"

msgid "Boshqa shablon tanlash"
msgstr "Шаблони дигар интихоб кардан"

#, python-format
msgid ""
"Eng ko'pi bilan %(soni)s ta rasm tanlashingiz mumkin. Iltimos, qaytadan "
"tanlang."
msgstr ""
"На бештар аз %(soni)s расм интихоб кардан мумкин аст. Лутфан аз нав интихоб "
"кунед."

#, python-format
msgid ""
"Fayl hajmi %(maks)s MB dan katta bo'lmasligi kerak (yuklangan fayl: "
"%(hajm).1f MB)."
msgstr ""
"Ҳаҷми файл набояд аз %(maks)s МБ зиёд бошад (файли боркардашуда: %(hajm).1f "
"МБ)."

#, python-format
msgid ""
"\"%(nomi)s\" fayli juda katta (%(hajm).1f MB). Rasm hajmi %(maks)s MB dan "
"oshmasligi kerak."
msgstr ""
"Файли \"%(nomi)s\" хеле калон аст (%(hajm).1f МБ). Ҳаҷми акс набояд аз "
"%(maks)s МБ зиёд бошад."

msgid "Iltimos, ismingizni kiriting."
msgstr "Лутфан номи худро ворид кунед."

msgid "Javobingiz uchun rahmat!"
msgstr "Барои ҷавобатон ташаккур!"

msgid "Bu taklifnomani o'chira olmaysiz."
msgstr "Шумо ин даъватномаро нест карда наметавонед."

#, python-format
msgid ""
"\"%(nomi)s\" taklifnomasi o'chirildi. Bu faollashtirilgan taklifnoma "
"bo'lgani uchun ma'lumotlari %(kun)s kun davomida saqlanadi — agar xato "
"bosgan bo'lsangiz, administratorga murojaat qiling."
msgstr ""
"Даъватномаи \"%(nomi)s\" нест карда шуд. Азбаски ин даъватномаи фаъолшуда "
"буд, маълумоти он %(kun)s рӯз нигоҳ дошта мешавад — агар иштибоҳан пахш "
"карда бошед, ба администратор муроҷиат кунед."

#, python-format
msgid "\"%(nomi)s\" taklifnomasi o'chirildi."
msgstr "Даъватномаи \"%(nomi)s\" нест карда шуд."

msgid "Sahifa topilmadi"
msgstr "Саҳифа ёфт нашуд"

msgid "Bunday sahifa topilmadi"
msgstr "Чунин саҳифа ёфт нашуд"

msgid "Havola noto'g'ri yoki bu sahifa endi mavjud emas."
msgstr "Пайванд нодуруст аст ё ин саҳифа дигар вуҷуд надорад."

msgid "Bosh sahifaga qaytish"
msgstr "Бозгашт ба саҳифаи асосӣ"

msgid "Xatolik yuz berdi"
msgstr "Хатогӣ рух дод"

msgid "Kechirasiz, xatolik yuz berdi"
msgstr "Мебахшед, хатогӣ рух дод"

msgid ""
"Sahifa vaqtincha ishlamayapti. Iltimos, birozdan so'ng qayta urinib ko'ring."
msgstr ""
"Саҳифа муваққатан кор намекунад. Лутфан пас аз чанде дубора кӯшиш кунед."

#, python-format
msgid "Sizni %(sana)s kunidagi marosimimizga taklif qilamiz"
msgstr "Шуморо ба маросими мо санаи %(sana)s даъват мекунем"

msgid "Oqqushlar — chiroyli elektron taklifnomalar"
msgstr "Oqqushlar — таклифномаҳои зебои электронӣ"

msgid ""
"O'zbekiston uchun eng chiroyli va zamonaviy elektron taklifnomalar. Bir "
"necha daqiqada yarating."
msgstr ""
"Зеботарин ва замонавитарин таклифномаҳои электронӣ барои Ӯзбекистон. Дар "
"чанд дақиқа созед."

