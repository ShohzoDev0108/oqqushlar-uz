msgid "%(ismlar)sning sunnat to'ylari"
msgstr "Маросимҳои суннат: %(ismlar)s"

msgid "Dizaynlar"
msgstr "Дизайнҳо"

msgid "Mening taklifnomalarim"
msgstr "Даъватномаҳои ман"

msgid "Musiqani yoqish/o'chirish"
msgstr "Мусиқиро фаъол/ғайрифаъол кунед"

msgid "Taklifnoma yaratish"
msgstr "Даъватнома сохтан"

msgid "Tilni tanlang"
msgstr "Забонро интихоб кунед"

msgid "chiroyli raqamli taklifnomalar"
msgstr "даъватномаҳои зебои рақамӣ"

msgid "Eng go'zal kuningiz uchun"
msgstr "Барои зеботарин рӯзи шумо"

msgid "raqamli taklifnoma"
msgstr "даъватномаи рақамӣ"

msgid "Tez va oson"
msgstr "Зуд ва осон"

msgid "Telefonda o'zingiz yarating"
msgstr "Худатон дар телефон созед"

msgid ""
"Dizaynni tanlang, ma'lumotlaringizni kiriting va tayyor taklifnomani shu "
"zahoti ko'ring — bor-yo'g'i 5 daqiqada, ro'yxatdan o'tmasdan. To'lov — faqat"
" yoqqanidan keyin."
msgstr ""
"Тарҳро интихоб кунед, маълумотро ворид кунед ва даъватномаи тайёрро дарҳол "
"бинед — ҳамагӣ дар 5 дақиқа, бе сабти ном. Пардохт — танҳо агар маъқул "
"шавад."

msgid "Barcha dizaynlarni ko'rish"
msgstr "Дидани ҳамаи дизайнҳо"

msgid "So'nggi taklifnomalar"
msgstr "Даъватномаҳои охирин"

msgid "Platformamizda faollashtirilgan taklifnomalardan namunalar"
msgstr "Намунаҳои даъватномаҳои фаъолшуда дар платформаи мо"

msgid "Nega Oqqushlar?"
msgstr "Чаро Oqqushlar?"

msgid "Boshqalardan nima bilan farq qilamiz"
msgstr "Мо аз дигарон бо чӣ фарқ мекунем"

msgid "To'lovsiz sinab ko'ring"
msgstr "Бе пул озмоед"

msgid "Avval ko'ring, keyin qaror qiling"
msgstr "Аввал бинед, баъд қарор диҳед"

msgid ""
"Ro'yxatdan o'tmasdan, hech narsa to'lamasdan taklifnomangizni to'liq "
"yaratib, o'z ko'zingiz bilan ko'rasiz. Yoqsagina to'lab faollashtirasiz."
msgstr ""
"Бе сабти ном, бе пардохт даъватномаи худро пурра эҷод карда, бо чашми худ "
"мебинед. Танҳо агар писанд ояд, барои фаъол кардан пардохт мекунед."

msgid "Har bir marosimga moslashgan"
msgstr "Барои ҳар чорабинӣ мутобиқ"

msgid "Forma marosim turingizni tushunadi"
msgstr "Шакл навъи чорабинии шуморо мефаҳмад"

msgid ""
"Nikoh to'yimi, sunnat to'yimi yoki tug'ilgan kunmi — forma so'raydigan "
"savollar va na'munaviy matnlar aynan shu marosimga mos ravishda o'zgaradi."
msgstr ""
"Тӯйи арӯсӣ, суннат ё зодрӯз — саволҳое, ки шакл медиҳад ва матнҳои намунавӣ "
"маҳз ба ҳамон чорабинӣ мувофиқ тағйир меёбанд."

msgid "Kim ko'rgani ma'lum"
msgstr "Маълум аст, ки кӣ дидааст"

msgid "Shaxsiy statistika sahifangiz"
msgstr "Саҳифаи шахсии омори шумо"

msgid ""
"Har bir mehmoningiz uchun alohida link yaratib, kim ko'rganini, kim "
"\"kelaman\" deganini — hammasini faqat sizga ko'rinadigan sahifada kuzatib "
"borasiz."
msgstr ""
"Барои ҳар меҳмонатон линки алоҳида созед ва дар саҳифае, ки танҳо ба шумо "
"намоён аст, пайгирӣ кунед, ки кӣ дидааст ва кӣ \"меоям\" гуфтааст."

msgid "Bir necha tilda"
msgstr "Ба якчанд забон"

msgid "Mehmonlaringiz o'z tilida o'qiydi"
msgstr "Меҳмонони шумо бо забони худ мехонанд"

msgid ""
"Taklifnoma o'zbek, rus, ingliz va boshqa bir necha tilda avtomatik ko'rinadi"
" — chet elda yoki boshqa millat vakili bo'lgan mehmonlaringiz ham "
"qiynalmaydi."
msgstr ""
"Даъватнома ба забонҳои ӯзбекӣ, русӣ, англисӣ ва якчанд забони дигар худкор "
"намоён мешавад — меҳмонони хориҷӣ ё миллати дигаратон низ душворӣ "
"намекашанд."

msgid "Istalgan qurilmada chiroyli"
msgstr "Дар ҳар дастгоҳ зебо"

msgid "Telefon, planshet, kompyuter"
msgstr "Телефон, планшет, компютер"

msgid ""
"Taklifnomangiz qaysi qurilmadan ochilmasin — ko'rinishi bir xil darajada "
"sara va o'qish qulay bo'ladi."
msgstr ""
"Даъватномаи шумо аз ҳар дастгоҳ кушода шавад — намуди он ба ҳамон андоза "
"зебо ва хониш осон хоҳад буд."

msgid "Marosimdan keyin ham"
msgstr "Ҳатто пас аз маросим"

msgid "Esdalik sifatida saqlanib qoladi"
msgstr "Ҳамчун ёдгорӣ боқӣ мемонад"

msgid ""
"Taklifnoma marosim o'tib ketgach ham o'chib qolmaydi — istalgan vaqt qayta "
"ochib, o'sha kunning iliqligini his qilishingiz mumkin."
msgstr ""
"Пас аз гузаштани маросим ҳам даъватнома нест намешавад — дар ҳар лаҳза "
"метавонед онро боз кушода, гармии он рӯзро эҳсос кунед."

msgid ""
"Taklifnoma yaratishda yordam kerak bo'lsa, <strong>xijolat bo'lmang</strong>"
" — Telegram orqali yozing, sizga bepul va samimiy yordam beramiz."
msgstr ""
"Агар ҳангоми эҷоди даъватнома кӯмак лозим шавад, <strong>хиҷолат "
"накашед</strong> — тавассути Telegram нависед, мо бепул ва самимона кӯмак "
"мерасонем."

msgid "Telegram orqali yozish"
msgstr "Тавассути Telegram навиштан"

msgid "Qanday ishlaydi?"
msgstr "Чӣ тавр кор мекунад?"

msgid "Uch oddiy qadam — va taklifnomangiz tayyor"
msgstr "Се қадами оддӣ — ва даъватномаи шумо тайёр"

msgid "Dizayn tanlang"
msgstr "Дизайн интихоб кунед"

msgid ""
"Bir nechta tayyor shablondan o'zingizga yoqqanini tanlang — har biri o'ziga "
"xos uslubda."
msgstr ""
"Аз якчанд шаблонҳои тайёр маъқулатонро интихоб кунед — ҳар яке услуби хос "
"дорад."

msgid "Ma'lumotlarni to'ldiring"
msgstr "Маълумотро пур кунед"

msgid ""
"Marosim turi, ismlar, sana, manzil, rasmlar va musiqa — hammasini o'zingiz "
"kiritasiz."
msgstr ""
"Навъи маросим, номҳо, сана, суроға, расмҳо ва мусиқӣ — ҳамаро худатон ворид "
"мекунед."

msgid "Ulashing"
msgstr "Мубодила кунед"

msgid ""
"Tayyor taklifnomani ko'rib chiqing, yoqsa faollashtiring va yaqinlaringizga "
"Telegram yoki Instagram orqali yuboring."
msgstr ""
"Даъватномаи тайёрро бинед, агар маъқул шавад, фаъол кунед ва ба наздиконатон"
" тавассути Telegram ё Instagram фиристед."

msgid "Dizayn shablonlari"
msgstr "Шаблонҳои дизайн"

msgid "Tanlang va shu zahoti o'zingiznikini yaratib ko'ring"
msgstr "Интихоб кунед ва дарҳол аз они худро созед"

msgid "Barchasi"
msgstr "Ҳама"

msgid "so'm"
msgstr "сум"

msgid "Savol-javob"
msgstr "Саволу ҷавоб"

msgid "Ko'p so'raladigan savollar"
msgstr "Саволҳои зуд-зуд додашаванда"

msgid "To'lovni qanday amalga oshiraman?"
msgstr "Пардохтро чӣ тавр анҷом диҳам?"

msgid ""
"Avval taklifnomangizni bepul yaratib, uni to'liq ko'rib chiqasiz. Yoqsa, "
"taklifnoma sahifasidagi \"Yoqdi\" tugmasini bosing — shu orqali sizni "
"to'g'ridan-to'g'ri Telegram'dagi adminimiz bilan bog'laymiz va to'lov "
"tafsilotlarini o'sha yerda kelishasiz. To'lov tasdiqlangach, taklifnomangiz "
"faollashtiriladi."
msgstr ""
"Аввал таклифномаи худро ройгон месозед ва пурра дида мебароед. Агар маъқул "
"шуд, тугмаи \"Маъқул шуд\"-ро дар саҳифаи таклифнома пахш кунед — ин шуморо "
"бевосита бо администратори мо дар Telegram пайваст мекунад, дар он ҷо "
"тафсилоти пардохтро мувофиқа мекунед. Пас аз тасдиқи пардохт, таклифномаи "
"шумо фаъол мешавад."

msgid "Ro'yxatdan o'tishim yoki parol o'ylab topishim kerakmi?"
msgstr "Оё бояд бақайдгирӣ кунам ё парол фикр кунам?"

msgid ""
"Yo'q. Hech qanday ro'yxatdan o'tish, email yoki parol talab qilinmaydi — "
"dizaynni tanlab, ma'lumotlaringizni kiritasiz, xolos. \"Mening "
"taklifnomalarim\" bo'limi orqali shu brauzeringizda yaratgan barcha "
"taklifnomalaringizni istalgan vaqt qayta topishingiz mumkin."
msgstr ""
"Не. Ҳеҷ гуна бақайдгирӣ, почтаи электронӣ ё парол лозим нест — шумо танҳо "
"тарҳро интихоб карда, маълумоти худро ворид мекунед. Тавассути бахши "
"\"Таклифномаҳои ман\" метавонед ҳамаи таклифномаҳое, ки дар ин браузер "
"сохтаед, дар ҳар вақт дубора пайдо кунед."

msgid "Ma'lumotlarda xato qilib qo'ysam, tuzata olamanmi?"
msgstr "Агар дар маълумот хато карда бошам, метавонам ислоҳ кунам?"

msgid ""
"Ha. Xuddi shu ism bilan formani qayta to'ldirsangiz, tizim avvalgi "
"taklifnomangizni taniydi va uni yangilashni yoki alohida saqlashni so'raydi."
" Kattaroq o'zgarish yoki muammo bo'lsa, taklifnoma sahifasidagi \"Yoqdi\" "
"tugmasi orqali to'g'ridan-to'g'ri adminimizga yozishingiz mumkin."
msgstr ""
"Ҳа. Агар шаклро бо ҳамон номҳо дубора пур кунед, система таклифномаи қаблии "
"шуморо мешиносад ва мепурсад, ки онро нав кунад ё алоҳида нигоҳ дорад. Барои"
" тағйироти калонтар ё мушкилот, метавонед тавассути тугмаи \"Маъқул шуд\" "
"дар саҳифаи таклифнома бевосита ба администратори мо нависед."

msgid "Taklifnoma linki qachon tugaydi?"
msgstr "Оё линки таклифнома тамом мешавад?"

msgid ""
"Avtomatik tugamaydi — to'y yoki marosim o'tib ketgandan keyin ham link "
"ishlab turadi. Uni faolsizlantirish kerak bo'lsa, faqat qo'lda (admin "
"panelidan) qilinadi."
msgstr ""
"Ба таври худкор тамом намешавад — линк ҳатто пас аз гузаштани тӯй ё маросим "
"низ кор мекунад. Ғайрифаъол кардани он танҳо дастӣ (аз панели админ) сурат "
"мегирад."

msgid "Mehmonlarim javobini (kelaman/kelolmayman) kuzatib borsam bo'ladimi?"
msgstr "Оё метавонам ҷавоби меҳмононамро (меоянд/намеоянд) пайгирӣ кунам?"

msgid ""
"Ha. Har bir taklifnomaning faqat sizga ko'rinadigan maxfiy statistika "
"sahifasi bor — u yerda nechta kishi ko'rgani, kim \"kelaman\" yoki "
"\"kelolmayman\" deb javob bergani va mehmonlarga bergan shaxsiy "
"linklaringizni kim ko'rib-ko'rmaganini kuzatib borasiz. Havolasini "
"\"Taklifnomangiz tayyor!\" sahifasida topasiz."
msgstr ""
"Ҳа. Ҳар як таклифнома саҳифаи хусусии оморӣ дорад, ки танҳо ба шумо намоён "
"аст — дар он ҷо метавонед пайгирӣ кунед, чанд нафар дида баромаданд, кӣ "
"\"меоям\" ё \"намеоям\" гуфта ҷавоб дод ва кадом меҳмон линки шахсии худро "
"дидааст ё не. Линкро дар саҳифаи \"Таклифномаи шумо тайёр аст!\" меёбед."

msgid "Nechta rasm va qanday musiqa qo'sha olaman?"
msgstr "Чанд акс ва кадом мусиқиро илова карда метавонам?"

msgid ""
"Taklifnomangizga eng ko'pi bilan 2 ta o'z rasmingizni (har biri 8 MB gacha) "
"yoki tayyor namunalardan tanlab qo'shishingiz mumkin. Musiqa uchun ham "
