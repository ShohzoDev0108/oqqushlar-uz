#: taklif/forms.py:28
msgid "Taklifnoma manzili (link)"
msgstr "Суроғаи даъватнома (пайванд)"

#: taklif/forms.py:31
msgid ""
"Faqat qisqa nom yozing, masalan: ollomurod-kamola — \"sayt.uz\" yoki \"/\" "
"belgisini yozmang, buni tizim o'zi qo'shadi."
msgstr ""
"Танҳо номи кӯтоҳ нависед, масалан: ollomurod-kamola — «sayt.uz» ё «/» "
"нанависед, инро система худаш илова мекунад."

#: taklif/forms.py:37
msgid "Marosim turi"
msgstr "Навъи маросим"

#: taklif/forms.py:42
msgid "Tayyor musiqalardan tanlash (ixtiyoriy)"
msgstr "Аз мусиқии тайёр интихоб кунед (ихтиёрӣ)"

#: taklif/forms.py:45
msgid "— tanlanmagan —"
msgstr "— интихоб нашудааст —"

#: taklif/forms.py:73
msgid "1-ism (masalan: kuyov, tug'ilgan kun egasi)"
msgstr "Номи 1 (масалан: домод, соҳиби ҷашн)"

#: taklif/forms.py:74
msgid "2-ism (ixtiyoriy, masalan: kelin)"
msgstr "Номи 2 (ихтиёрӣ, масалан: арӯс)"

#: taklif/forms.py:75 taklif/forms.py:88
msgid "Tadbir sanasi va vaqti"
msgstr "Сана ва вақти чорабинӣ"

#: taklif/forms.py:76
msgid "To'yxona/manzil nomi"
msgstr "Номи толор/ҷой"

