#: taklif/templates/taklif/yaratildi.html:30
msgid "Taklifnomangiz tayyor!"
msgstr "Shaqırıwıńız tayar!"

#: taklif/templates/taklif/yaratildi.html:32
msgid "Bu — sizning shaxsiy havolangiz. Mehmonlaringizga shuni yuborasiz:"
msgstr "Bul — sizdiń jeke siltemeńiz. Onı qonaqlarıńızǵa jiberiń:"

#: taklif/templates/taklif/yaratildi.html:35
msgid "Taklifnomani ko'rish"
msgstr "Shaqırıwdı kóriw"

#: taklif/templates/taklif/yaratildi.html:38
msgid ""
"Yuqoridagi tugma orqali taklifnomangizni ko'rib, hammasi to'g'ri ekanligiga "
"ishonch hosil qiling."
msgstr ""
"Joqarıdaǵı túyme arqalı shaqırıwıńızdı kórip, hámmesiniń durıslıǵına isenim "
"payda etiń."

#: taklif/templates/taklif/yaratildi.html:39
#, python-format
msgid ""
"Yoqsa — taklifnoma sahifasidagi <strong>\"Yoqdi\"</strong> tugmasini bosing,"
" shu orqali to'g'ridan-to'g'ri Telegram orqali <strong>%(admin)s</strong> "
"bilan bog'lanib to'lovni amalga oshirasiz."
msgstr ""
"Unasa — shaqırıw betindegi <strong>«Unadı»</strong> túymesin basıń: sonday "
"etip Telegram arqalı tuwrıdan-tuwrı <strong>%(admin)s</strong> penen "
"baylanısıp, tólem jasaysız."

#: taklif/templates/taklif/yaratildi.html:40
msgid ""
"To'lov tasdiqlangach, taklifnomangiz faollashtiriladi va uni "
"mehmonlaringizga (Telegram, Instagram va h.k.) yuborishingiz mumkin bo'ladi."
msgstr ""
"Tólem tastıyıqlanǵannan keyin shaqırıwıńız belsendiriledi hám onı qonaqlarǵa"
" jiberе alasız (Telegram, Instagram h.t.b.)."

#: taklif/templates/taklif/yaratish.html:62
msgid "shabloni"
msgstr "shablonı"

#: taklif/templates/taklif/yaratish.html:64
msgid ""
"Ma'lumotlaringizni to'ldiring. Yuborgach — taklifnomangiz shu zahoti tayyor "
"bo'ladi (hali hech kimga ochiq emas)."
msgstr ""
"Maǵlıwmatlarıńızdı толтырың. Jiberilgennen keyin shaqırıw xatıńız dárhal "
"tayın boladı (házirshe eshkimge kórinbeydi)."

#: taklif/templates/taklif/yaratish.html:73
#, python-format
msgid ""
"Sizda <strong>%(ism1)s %(ism2)s</strong> nomi bilan taklifnoma allaqachon "
"bor (shu brauzerda avval yaratilgan)."
msgstr ""
"Sizde <strong>%(ism1)s %(ism2)s</strong> atları menen shaqırıw xatı bar eken"
" (aldın usı brauzerde jaratılǵan)."

#: taklif/templates/taklif/yaratish.html:74
msgid "Nima qilamiz?"
msgstr "Ne isteymiz?"

#: taklif/templates/taklif/yaratish.html:76
msgid "Buni yangilayman (eskisi o'chadi)"
msgstr "Munı jańalayman (eskisi óshedi)"

#: taklif/templates/taklif/yaratish.html:77
msgid "Yo'q, alohida saqlayman"
msgstr "Yaq, bólek saqlayman"

#: taklif/templates/taklif/yaratish.html:94
#, python-format
msgid "Rasmlar (eng ko'pi bilan %(soni)s ta, ixtiyoriy)"
msgstr "Súwretler (eń kóbi %(soni)s dana, mindetli emes)"

#: taklif/templates/taklif/yaratish.html:96
msgid "O'z fotoyingiz hali bo'lmasa, tayyor namunalardan tanlashingiz mumkin:"
msgstr "Eger óz súwretińiz áli bolmasa, tayar úlgilerden tańlaw múmkin:"

#: taklif/templates/taklif/yaratish.html:106
msgid "yoki"
msgstr "yamasa"

#: taklif/templates/taklif/yaratish.html:108
msgid "O'zingizning rasmingizni yuklang"
msgstr "Óz súwretińizdi júkleń"

#: taklif/templates/taklif/yaratish.html:114
msgid "Taklifnomani yaratish"
msgstr "Shaqırıwdı jaratıw"

#: taklif/templates/taklif/yaratish.html:118
msgid "Boshqa shablon tanlash"
msgstr "Basqa shablon tanlaw"

#: taklif/templates/taklif/yaratish.html:154
#, python-format
msgid ""
"Eng ko'pi bilan %(soni)s ta rasm tanlashingiz mumkin. Iltimos, qaytadan "
"tanlang."
msgstr "Eń kóbi %(soni)s súwret tanlay alasız. Qaytadan tanlań."

#: taklif/views.py:381
msgid "Javobingiz uchun rahmat!"
msgstr "Juwabıńız ushın raxmet!"

#: taklif/views.py:383
msgid "Iltimos, ismingizni kiriting."
msgstr "Ótinish, atıńızdı kiritiń."

#: templates/base.html:20
#, python-format
msgid "Sizni %(sana)s kunidagi marosimimizga taklif qilamiz"
msgstr "Sizdi %(sana)s kúngi toyımızǵa shaqıramız"

#: templates/base.html:31
msgid "Oqqushlar — chiroyli elektron taklifnomalar"
msgstr "Oqqushlar — sulıw elektron shaqırıw xatları"

#: templates/base.html:32
msgid ""
"O'zbekiston uchun eng chiroyli va zamonaviy elektron taklifnomalar. Bir "
"necha daqiqada yarating."
msgstr ""
"Ózbekstan ushın eń sulıw ha'm zamanagóy elektron shaqırıw xatları. Birneshe "
"minutta jaratıń."
