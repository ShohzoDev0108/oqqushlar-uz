#: taklif/forms.py:237
msgid ""
"Taklifnomangiz sayt bosh sahifasida namuna sifatida boshqa mijozlarga "
"ko'rsatilishiga rozimisiz?"
msgstr ""
"Shaqırıwıńızdıń saittıń bas betinde basqa xarıydarlarǵa úlgi sıpatında "
"kórsetiliwine razımısız?"

#: taklif/forms.py:252
msgid "Marosim turini ro'yxatda topa olmasangiz shu yerga o'zingiz yozing."
msgstr "Ma'resim túrin dizimnen taba almasańız, usı jerge óziniz jazıń."

#: taklif/forms.py:255
msgid "Taklifnomada mehmonlarga to'g'ridan-to'g'ri shu matn ko'rsatiladi."
msgstr "Bul tekst shaqırıwda qonaqlarǵa tikkeley kórsetiledi."

#: taklif/forms.py:258
msgid "O'zingiz yuklamoqchi bo'lsangiz"
msgstr "Óz faylıńızdı júklewdi qáleseńiz"

#: taklif/forms.py:260
msgid ""
"Ixtiyoriy. Belgilamasangiz ham taklifnomangiz odatdagidek ishlayveradi — bu "
"faqat bosh sahifadagi namunalar ro'yxatiga tegishli."
msgstr ""
"Májbúriy emes. Belgilemeseńiz de, shaqırıwıńız ádettegidey isleydi — bul tek "
"bas bettegi úlgiler dizimine tiyisli."

#: taklif/forms.py:272
msgid "Bu marosim turi uchun ikkinchi ismni ham kiriting."
msgstr "Bul ilaj túri ushın ekinshi attı da kiritiń."

