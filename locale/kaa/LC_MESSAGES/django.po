msgid "Marosim turi"
msgstr "Ilaj túri"

msgid "Tayyor musiqalardan tanlash (ixtiyoriy)"
msgstr "Tayar muzıkalardan tanlaw (mindetli emes)"

msgid "— tanlanmagan —"
msgstr "— tanlanbaǵan —"

msgid "1-ism (masalan: kuyov, tug'ilgan kun egasi)"
msgstr "1-atı (mısalı: kúyew, tuwılǵan kún iyesi)"

msgid "2-ism (ixtiyoriy, masalan: kelin)"
msgstr "2-atı (májbúriy emes, mısalı: kelin)"

msgid "Tadbir sanasi va vaqti"
msgstr "Ilaj sánesi hám waqtı"

msgid "To'yxona/manzil nomi"
msgstr "Toy zalı/orın atı"

