#: taklif/forms.py:70
msgid "2-ism (ixtiyoriy, masalan: kelin)"
msgstr "2-atı (májbúriy emes, mısalı: kelin)"

#: taklif/forms.py:71 taklif/forms.py:88
msgid "Tadbir sanasi va vaqti"
msgstr "Ilaj sánesi hám waqtı"

#: taklif/forms.py:72
msgid "To'yxona/manzil nomi"
msgstr "Toy zalı/orın atı"

#: taklif/forms.py:73 taklif/templates/taklif/shablonlar/_bolimlar.html:272
msgid "Manzil"
msgstr "Mánzil"

#: taklif/forms.py:74
