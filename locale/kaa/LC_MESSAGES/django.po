msgstr "Karta siltemesi (mindetli emes)"

#: taklif/forms.py:75
msgid "Kiyinish kodi (ixtiyoriy)"
msgstr "Kiyim kodi (mindetli emes)"

#: taklif/forms.py:76
msgid "O'zingiz musiqa yuklash (ixtiyoriy)"
msgstr "Óz muzıkańızdı júklew (mindetli emes)"

#: taklif/forms.py:77
msgid "Qo'shimcha tabrik matni (ixtiyoriy)"
msgstr "Qosımsha qutlıqlaw teksti (mindetli emes)"

#: taklif/forms.py:78
msgid "Sovg'a-pul uchun karta raqami (ixtiyoriy)"
msgstr "Aqshalıq sıylıq ushın karta nomeri (mindetli emes)"

#: taklif/forms.py:79
msgid "Mehmonlar uchun Telegram guruhi (ixtiyoriy)"
msgstr "Qonaqlar ushın Telegram gruppası (mindetli emes)"

#: taklif/forms.py:81
msgid ""
"Taklifnomangiz sayt bosh sahifasida namuna sifatida boshqa mijozlarga "
"ko'rsatilishiga rozimisiz?"
msgstr ""
"Shaqırıwıńızdıń saittıń bas betinde basqa xarıydarlarǵa úlgi sıpatında "
"kórsetiliwine razımısız?"

#: taklif/forms.py:86
msgid "Masalan: kuyov, tug'ilgan kun egasi"
msgstr "Mısalı: kúyew, tuwılǵan kún iyesi"

#: taklif/forms.py:87
msgid "Ikkinchi ism (masalan: kelin). Kerak bo'lmasa bo'sh qoldiring"
msgstr "Ekinshi atı (mısalı: kelin). Kerek bolmasa bos qaldırıń"

#: taklif/forms.py:89
msgid "Masalan: rasmiy, yorug' ranglar"
msgstr "Mısalı: rásmiy, ashıq reńler"

#: taklif/forms.py:90
msgid "O'zingiz yuklamoqchi bo'lsangiz"
msgstr "Óz faylıńızdı júklewdi qáleseńiz"

#: taklif/forms.py:91
msgid "Qo'shimcha tabrik/taklif matni"
msgstr "Qosımsha qutlıqlaw/shaqırıw teksti"

#: taklif/forms.py:92
msgid "Pul sovg'a uchun karta raqami"
msgstr "Aqshalıq sıylıq ushın karta nomeri"

#: taklif/forms.py:93
msgid "Mehmonlar uchun Telegram guruh/kanal havolasi"
msgstr "Qonaqlar ushın Telegram gruppası/kanalınıń siltemesi"

#: taklif/forms.py:95
msgid ""
"Ixtiyoriy. Yoqmasangiz ham taklifnomangiz odatdagidek ishlayveradi — bu "
"faqat bosh sahifadagi namunalar ro'yxatiga tegishli."
msgstr ""
"Májbúriy emes. Qospasańız da, shaqırıwıńız ádettegidey isleydi — bul tek bas"
" bettegi úlgiler dizimine tiyisli."

#: taklif/forms.py:107
msgid "Bu marosim turi uchun ikkinchi ismni ham kiriting."
msgstr "Bul ilaj túri ushın ekinshi attı da kiritiń."

