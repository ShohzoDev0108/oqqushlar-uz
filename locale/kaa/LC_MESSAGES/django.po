msgstr "Bet tabılmadı"

msgid "Bunday sahifa topilmadi"
msgstr "Bunday bet tabılmadı"

msgid "Havola noto'g'ri yoki bu sahifa endi mavjud emas."
msgstr "Silteme qáte yamasa bul bet endi joq."

msgid "Bosh sahifaga qaytish"
msgstr "Bas betke qaytıw"

