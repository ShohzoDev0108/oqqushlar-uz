msgstr "Bu myhmanyň şahsy linki pozulsynmy?"

#: taklif/templates/taklif/statistika.html:159
msgid "Hali mehmon qo'shilmagan. Yuqoridagi formadan qo'shing."
msgstr "Heniz myhman goşulmady. Olary ýokardaky forma arkaly goşuň."

#: taklif/templates/taklif/yaratildi.html:4
msgid "Tayyor!"
msgstr "Taýýar!"

#: taklif/templates/taklif/yaratildi.html:48
