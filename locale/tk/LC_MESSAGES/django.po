msgstr "Bu dabara görnüşi üçin ikinji ady hem giriziň."

#: taklif/forms.py:120
msgid "Iltimos, to'g'ri nom kiriting (masalan: ollomurod-kamola)."
msgstr "Dogry at giriziň (mysal üçin: ollomurod-kamola)."

#: taklif/forms.py:124
msgid "Bu nom tizim tomonidan band qilingan, boshqa nom tanlang."
msgstr "Bu at ulgam tarapyndan bellenen, başgasyny saýlaň."

#: taklif/forms.py:128
msgid "Bu manzil band, boshqa nom tanlang (masalan oxiriga raqam qo'shing)."
msgstr "Bu salgy eýelenen, başga at saýlaň (mysal üçin, soňuna san goşuň)."

