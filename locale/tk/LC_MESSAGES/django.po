msgstr "Çakylygyň salgysy (baglanyşyk)"

#: taklif/forms.py:31
msgid ""
"Faqat qisqa nom yozing, masalan: ollomurod-kamola — \"sayt.uz\" yoki \"/\" "
"belgisini yozmang, buni tizim o'zi qo'shadi."
msgstr ""
"Diňe gysga at ýazyň, mysal üçin: ollomurod-kamola — «sayt.uz» ýa-da «/» "
"ýazmaň, muny ulgam özi goşar."

