msgstr "Karta baglanyşygy (hökmany däl)"

#: taklif/forms.py:75
msgid "Kiyinish kodi (ixtiyoriy)"
msgstr "Egin-eşik kody (hökmany däl)"

#: taklif/forms.py:76
msgid "O'zingiz musiqa yuklash (ixtiyoriy)"
msgstr "Öz sazyňyzy ýüklemek (hökmany däl)"

#: taklif/forms.py:77
msgid "Qo'shimcha tabrik matni (ixtiyoriy)"
msgstr "Goşmaça gutlag teksti (hökmany däl)"

#: taklif/forms.py:78
msgid "Sovg'a-pul uchun karta raqami (ixtiyoriy)"
msgstr "Pul sowgady üçin kart belgisi (hökmany däl)"

#: taklif/forms.py:79
msgid "Mehmonlar uchun Telegram guruhi (ixtiyoriy)"
msgstr "Myhmanlar üçin Telegram topary (hökmany däl)"

#: taklif/forms.py:81
msgid ""
"Taklifnomangiz sayt bosh sahifasida namuna sifatida boshqa mijozlarga "
"ko'rsatilishiga rozimisiz?"
msgstr ""
"Çakylygyňyzyň saýtyň baş sahypasynda başga müşderilere nusga hökmünde "
"görkezilmegine razymysyňyz?"

#: taklif/forms.py:86
msgid "Masalan: kuyov, tug'ilgan kun egasi"
msgstr "Meselem: ýigit, doglan günüň eýesi"

#: taklif/forms.py:87
msgid "Ikkinchi ism (masalan: kelin). Kerak bo'lmasa bo'sh qoldiring"
msgstr "Ikinji at (meselem: gelin). Gerek bolmasa boş goýuň"

#: taklif/forms.py:89
msgid "Masalan: rasmiy, yorug' ranglar"
msgstr "Mysal üçin: resmi, açyk reňkler"

#: taklif/forms.py:90
msgid "O'zingiz yuklamoqchi bo'lsangiz"
msgstr "Öz faýlyňyzy ýüklemek isleseňiz"

#: taklif/forms.py:91
msgid "Qo'shimcha tabrik/taklif matni"
msgstr "Goşmaça gutlag/çakylyk teksti"

#: taklif/forms.py:92
msgid "Pul sovg'a uchun karta raqami"
msgstr "Pul sowgady üçin kart belgisi"

#: taklif/forms.py:93
msgid "Mehmonlar uchun Telegram guruh/kanal havolasi"
msgstr "Myhmanlar üçin Telegram topary/kanalynyň baglanyşygy"

#: taklif/forms.py:95
msgid ""
"Ixtiyoriy. Yoqmasangiz ham taklifnomangiz odatdagidek ishlayveradi — bu "
"faqat bosh sahifadagi namunalar ro'yxatiga tegishli."
msgstr ""
"Hökmany däl. Ýakmasaňyz-da, çakylygyňyz adatdakysy ýaly işlär — bu diňe baş "
"sahypadaky nusgalar sanawyna degişli."

#: taklif/forms.py:107
msgid "Bu marosim turi uchun ikkinchi ismni ham kiriting."
msgstr "Bu dabara görnüşi üçin ikinji ady hem giriziň."

