#: taklif/forms.py:28
msgid "Taklifnoma manzili (link)"
msgstr "Адрес приглашения (ссылка)"

#: taklif/forms.py:31
msgid ""
"Faqat qisqa nom yozing, masalan: ollomurod-kamola — \"sayt.uz\" yoki \"/\" "
"belgisini yozmang, buni tizim o'zi qo'shadi."
msgstr ""
"Напишите только короткое имя, например: ollomurod-kamola — не пишите "
"«sayt.uz» или «/», система добавит это сама."

#: taklif/forms.py:37
msgid "Marosim turi"
msgstr "Тип мероприятия"

#: taklif/forms.py:42
msgid "Tayyor musiqalardan tanlash (ixtiyoriy)"
msgstr "Выбрать из готовой музыки (необязательно)"

#: taklif/forms.py:45
msgid "— tanlanmagan —"
msgstr "— не выбрано —"

#: taklif/forms.py:73
msgid "1-ism (masalan: kelin, tug'ilgan kun egasi)"
msgstr "1-е имя (например: невеста, именинник)"

#: taklif/forms.py:74
msgid "2-ism (ixtiyoriy, masalan: kuyov)"
msgstr "2-е имя (необязательно, например: жених)"

#: taklif/forms.py:75 taklif/forms.py:88
msgid "Tadbir sanasi va vaqti"
msgstr "Дата и время мероприятия"

#: taklif/forms.py:76
msgid "To'yxona/manzil nomi"
msgstr "Название зала/места"

