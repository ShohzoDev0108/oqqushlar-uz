#: taklif/templates/taklif/shablon_tanlash.html:23
msgid "Shablon tanlang"
msgstr "Выберите шаблон"

#: taklif/templates/taklif/shablon_tanlash.html:25
msgid ""
"Sizga yoqqan dizaynni tanlang — keyingi bosqichda o'z ma'lumotlaringizni "
