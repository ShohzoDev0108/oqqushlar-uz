#: taklif/templates/taklif/bosh_sahifa.html:235
msgid "So'nggi taklifnomalar"
msgstr "Последние приглашения"

#: taklif/templates/taklif/bosh_sahifa.html:236
msgid "Platformamizda faollashtirilgan taklifnomalardan namunalar"
msgstr "Примеры активированных приглашений на нашей платформе"

#: taklif/templates/taklif/bosh_sahifa.html:249
msgid "Hali faollashtirilgan taklifnoma yo'q — birinchi bo'lib siz yarating!"
msgstr "Пока нет активированных приглашений — создайте первым!"

#: taklif/templates/taklif/bosh_sahifa.html:254
msgid "Admin panel"
msgstr "Админ-панель"

#: taklif/templates/taklif/mening_taklifnomalarim.html:45
#: taklif/templates/taklif/shablon_tanlash.html:70
msgid "Bosh sahifa"
msgstr "Главная"

#: taklif/templates/taklif/mening_taklifnomalarim.html:52
msgid ""
"Bu ro'yxat sizning shu brauzerda yaratgan barcha taklifnomalaringizni "
"ko'rsatadi — ularni solishtirib, eng yoqqanini tanlashingiz mumkin."
msgstr ""
"Этот список показывает все приглашения, созданные вами в этом браузере — "
"сравните их и выберите самое лучшее."

#: taklif/templates/taklif/mening_taklifnomalarim.html:55
#: taklif/templates/taklif/yaratildi.html:46
msgid "Yana bitta yaratish"
msgstr "Создать ещё одно"

#: taklif/templates/taklif/mening_taklifnomalarim.html:65
msgid "Faollashtirilgan"
msgstr "Активировано"

#: taklif/templates/taklif/mening_taklifnomalarim.html:67
msgid "To'lov kutilmoqda"
msgstr "Ожидается оплата"

#: taklif/templates/taklif/mening_taklifnomalarim.html:70
msgid "Ko'rish"
msgstr "Смотреть"

#: taklif/templates/taklif/mening_taklifnomalarim.html:72
msgid "Yoqdi"
msgstr "Нравится"

#: taklif/templates/taklif/mening_taklifnomalarim.html:79
msgid "Siz hali hech qanday taklifnoma yaratmagansiz."
msgstr "Вы ещё не создали ни одного приглашения."

#: taklif/templates/taklif/muddati_tugagan.html:4
msgid "Taklifnoma yopilgan"
msgstr "Приглашение закрыто"

#: taklif/templates/taklif/muddati_tugagan.html:18
msgid "Ushbu taklifnoma sahifasi yopilgan"
msgstr "Эта страница приглашения закрыта"

