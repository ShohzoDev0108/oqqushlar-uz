msgstr "Юбилей"

msgid "Tug'ilgan kun"
msgstr "День рождения"

msgid "Boshqa"
msgstr "Другое"

msgid "Zamonaviy"
msgstr "Современный"

msgid "Milliy"
msgstr "Национальный"

msgid "Bolalar"
msgstr "Детский"

