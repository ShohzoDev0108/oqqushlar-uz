msgstr "Ссылка на карту (необязательно)"

#: taklif/forms.py:79
msgid "Kiyinish kodi (ixtiyoriy)"
msgstr "Дресс-код (необязательно)"

#: taklif/forms.py:80
msgid "O'zingiz musiqa yuklash (ixtiyoriy)"
msgstr "Загрузить свою музыку (необязательно)"

#: taklif/forms.py:81
msgid "Qo'shimcha tabrik matni (ixtiyoriy)"
msgstr "Дополнительный текст поздравления (необязательно)"

#: taklif/forms.py:82
msgid "Sovg'a-pul uchun karta raqami (ixtiyoriy)"
msgstr "Номер карты для денежного подарка (необязательно)"

#: taklif/forms.py:83
msgid "Mehmonlar uchun Telegram guruhi (ixtiyoriy)"
msgstr "Telegram-группа для гостей (необязательно)"

#: taklif/forms.py:86
msgid "Masalan: kelin, tug'ilgan kun egasi"
msgstr "Например: невеста, именинник"

#: taklif/forms.py:87
msgid "Ikkinchi ism (masalan: kuyov). Kerak bo'lmasa bo'sh qoldiring"
msgstr "Второе имя (например: жених). Если не нужно — оставьте пустым"

#: taklif/forms.py:89
msgid "Masalan: rasmiy, yorug' ranglar"
msgstr "Например: официальный, светлые тона"

#: taklif/forms.py:90
msgid "O'zingiz yuklamoqchi bo'lsangiz"
msgstr "Если хотите загрузить свой файл"

#: taklif/forms.py:91
msgid "Qo'shimcha tabrik/taklif matni"
msgstr "Дополнительный текст поздравления/приглашения"

#: taklif/forms.py:92
msgid "Pul sovg'a uchun karta raqami"
msgstr "Номер карты для денежного подарка"

#: taklif/forms.py:93
msgid "Mehmonlar uchun Telegram guruh/kanal havolasi"
msgstr "Ссылка на Telegram-группу/канал для гостей"

#: taklif/forms.py:103
msgid "Bu marosim turi uchun ikkinchi ismni ham kiriting."
msgstr "Для этого типа мероприятия введите и второе имя."

#: taklif/forms.py:120
msgid "Iltimos, to'g'ri nom kiriting (masalan: ollomurod-kamola)."
msgstr "Пожалуйста, введите корректное имя (например: ollomurod-kamola)."

#: taklif/forms.py:124
msgid "Bu nom tizim tomonidan band qilingan, boshqa nom tanlang."
msgstr "Это имя зарезервировано системой, выберите другое."

#: taklif/forms.py:128
msgid "Bu manzil band, boshqa nom tanlang (masalan oxiriga raqam qo'shing)."
msgstr ""
"Этот адрес занят, выберите другое имя (например, добавьте цифру в конце)."

