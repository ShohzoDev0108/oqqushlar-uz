#: taklif/forms.py:29
msgid "Marosim turi"
msgstr "Іс-шара түрі"

#: taklif/forms.py:34
msgid "Tayyor musiqalardan tanlash (ixtiyoriy)"
msgstr "Дайын музыкадан таңдау (міндетті емес)"

#: taklif/forms.py:37
msgid "— tanlanmagan —"
msgstr "— таңдалмаған —"

#: taklif/forms.py:69
msgid "1-ism (masalan: kuyov, tug'ilgan kun egasi)"
msgstr "1-есім (мысалы: күйеу жігіт, туған күн иесі)"

#: taklif/forms.py:70
msgid "2-ism (ixtiyoriy, masalan: kelin)"
msgstr "2-есім (міндетті емес, мысалы: қалыңдық)"

#: taklif/forms.py:71 taklif/forms.py:88
msgid "Tadbir sanasi va vaqti"
msgstr "Іс-шара күні мен уақыты"

#: taklif/forms.py:72
msgid "To'yxona/manzil nomi"
msgstr "Той залы/орын атауы"

#: taklif/forms.py:73 taklif/templates/taklif/shablonlar/_bolimlar.html:272
msgid "Manzil"
msgstr "Мекенжай"

#: taklif/forms.py:74
msgid "Xarita havolasi (ixtiyoriy)"
msgstr "Карта сілтемесі (міндетті емес)"

#: taklif/forms.py:75
msgid "Kiyinish kodi (ixtiyoriy)"
msgstr "Киім коды (міндетті емес)"

#: taklif/forms.py:76
msgid "O'zingiz musiqa yuklash (ixtiyoriy)"
msgstr "Өз музыкаңызды жүктеу (міндетті емес)"

#: taklif/forms.py:77
msgid "Qo'shimcha tabrik matni (ixtiyoriy)"
msgstr "Қосымша құттықтау мәтіні (міндетті емес)"

#: taklif/forms.py:78
msgid "Sovg'a-pul uchun karta raqami (ixtiyoriy)"
msgstr "Ақшалай сыйлыққа карта нөмірі (міндетті емес)"

#: taklif/forms.py:79
msgid "Mehmonlar uchun Telegram guruhi (ixtiyoriy)"
msgstr "Қонақтарға арналған Telegram тобы (міндетті емес)"

#: taklif/forms.py:81
msgid ""
"Taklifnomangiz sayt bosh sahifasida namuna sifatida boshqa mijozlarga "
"ko'rsatilishiga rozimisiz?"
msgstr ""
"Шақыруыңыздың сайттың басты бетінде басқа тұтынушыларға үлгі ретінде "
"көрсетілуіне келісесіз бе?"

#: taklif/forms.py:86
msgid "Masalan: kuyov, tug'ilgan kun egasi"
msgstr "Мысалы: күйеу жігіт, туған күн иесі"

#: taklif/forms.py:87
msgid "Ikkinchi ism (masalan: kelin). Kerak bo'lmasa bo'sh qoldiring"
msgstr "Екінші есім (мысалы: қалыңдық). Қажет болмаса, бос қалдырыңыз"

#: taklif/forms.py:89
msgid "Masalan: rasmiy, yorug' ranglar"
msgstr "Мысалы: ресми, ашық түстер"

#: taklif/forms.py:90
msgid "O'zingiz yuklamoqchi bo'lsangiz"
msgstr "Өз файлыңызды жүктегіңіз келсе"

#: taklif/forms.py:91
msgid "Qo'shimcha tabrik/taklif matni"
msgstr "Қосымша құттықтау/шақыру мәтіні"

#: taklif/forms.py:92
msgid "Pul sovg'a uchun karta raqami"
msgstr "Ақшалай сыйлыққа карта нөмірі"

#: taklif/forms.py:93
msgid "Mehmonlar uchun Telegram guruh/kanal havolasi"
msgstr "Қонақтарға арналған Telegram тобы/арнасының сілтемесі"

#: taklif/forms.py:95
msgid ""
"Ixtiyoriy. Yoqmasangiz ham taklifnomangiz odatdagidek ishlayveradi — bu "
"faqat bosh sahifadagi namunalar ro'yxatiga tegishli."
msgstr ""
"Міндетті емес. Қоспасаңыз да, шақыруыңыз әдеттегідей жұмыс істей береді — "
"бұл тек басты беттегі үлгілер тізіміне қатысты."

#: taklif/forms.py:107
msgid "Bu marosim turi uchun ikkinchi ismni ham kiriting."
msgstr "Бұл іс-шара түрі үшін екінші есімді де енгізіңіз."

#: taklif/models.py:42
msgid "Nikoh to'yi"
msgstr "Неке тойы"

#: taklif/models.py:43
msgid "Qiz uzatish"
msgstr "Қыз ұзату"

#: taklif/models.py:44
msgid "Sunnat to'yi"
msgstr "Сүндет той"

#: taklif/models.py:45
msgid "Beshik to'yi"
msgstr "Бесік той"

#: taklif/models.py:46
msgid "Nahor oshi"
msgstr "Таңғы палау (наҳор оши)"

#: taklif/models.py:47
msgid "Yubiley"
msgstr "Мерейтой"

#: taklif/models.py:48
msgid "Tug'ilgan kun"
msgstr "Туған күн"

#: taklif/models.py:49
msgid "Boshqa"
msgstr "Басқа"

#: taklif/models.py:58 taklif/templates/taklif/bosh_sahifa.html:292
#: taklif/templates/taklif/shablon_tanlash.html:34
msgid "Zamonaviy"
msgstr "Заманауи"

#: taklif/models.py:59 taklif/templates/taklif/bosh_sahifa.html:293
#: taklif/templates/taklif/shablon_tanlash.html:35
msgid "Milliy"
msgstr "Ұлттық"

#: taklif/models.py:60 taklif/templates/taklif/bosh_sahifa.html:294
#: taklif/templates/taklif/shablon_tanlash.html:36
msgid "Bolalar"
msgstr "Балалар"

#: taklif/templates/taklif/_sayt_footer.html:9
#: taklif/templates/taklif/_sayt_nav.html:14
#: taklif/templates/taklif/shablon_tanlash.html:22
#: taklif/templates/taklif/yaratish.html:65
msgid "Dizaynlar"
msgstr "Дизайндар"

#: taklif/templates/taklif/_sayt_footer.html:10
#: taklif/templates/taklif/_sayt_nav.html:15
#: taklif/templates/taklif/mening_taklifnomalarim.html:4
#: taklif/templates/taklif/mening_taklifnomalarim.html:42
#: taklif/templates/taklif/mening_taklifnomalarim.html:44
#: taklif/templates/taklif/shablonlar/_mijoz_qismi.html:20
#: taklif/templates/taklif/yaratildi.html:58
msgid "Mening taklifnomalarim"
msgstr "Менің шақыруларым"

#: taklif/templates/taklif/_sayt_musiqa.html:11
#: taklif/templates/taklif/shablonlar/_mijoz_qismi.html:26
msgid "Musiqani yoqish/o'chirish"
msgstr "Музыканы қосу/өшіру"

#: taklif/templates/taklif/_sayt_nav.html:19
#: taklif/templates/taklif/_sayt_nav.html:25
#: taklif/templates/taklif/bosh_sahifa.html:213
#: taklif/templates/taklif/yaratish.html:4
msgid "Taklifnoma yaratish"
msgstr "Шақыру жасау"

#: taklif/templates/taklif/_til_almashtirish.html:25
#: taklif/templates/taklif/_til_almashtirish.html:37
msgid "Tilni tanlang"
msgstr "Тілді таңдаңыз"

#: taklif/templates/taklif/bosh_sahifa.html:4
msgid "chiroyli raqamli taklifnomalar"
msgstr "әдемі цифрлық шақырулар"

#: taklif/templates/taklif/bosh_sahifa.html:205
msgid "Eng go'zal kuningiz uchun"
msgstr "Ең әдемі күніңіз үшін"

#: taklif/templates/taklif/bosh_sahifa.html:205
msgid "raqamli taklifnoma"
msgstr "цифрлық шақыру"

#: taklif/templates/taklif/bosh_sahifa.html:207
msgid "Tez va oson"
msgstr "Жылдам әрі оңай"

#: taklif/templates/taklif/bosh_sahifa.html:208
msgid "Telefonda o'zingiz yarating"
msgstr "Телефоннан өзіңіз жасаңыз"

#: taklif/templates/taklif/bosh_sahifa.html:210
msgid ""
"Dizaynni tanlang, ma'lumotlaringizni kiriting va tayyor taklifnomani shu "
"zahoti ko'ring — bor-yo'g'i 5 daqiqada, ro'yxatdan o'tmasdan. To'lov — faqat"
" yoqqanidan keyin."
msgstr ""
"Дизайнды таңдаңыз, деректеріңізді енгізіңіз және дайын шақыруды бірден "
"көріңіз — небәрі 5 минутта, тіркелусіз. Төлем — тек ұнаса ғана."

#: taklif/templates/taklif/bosh_sahifa.html:214
msgid "Barcha dizaynlarni ko'rish"
msgstr "Барлық дизайндарды көру"

#: taklif/templates/taklif/bosh_sahifa.html:236
msgid "So'nggi taklifnomalar"
msgstr "Соңғы шақырулар"

#: taklif/templates/taklif/bosh_sahifa.html:237
msgid "Platformamizda faollashtirilgan taklifnomalardan namunalar"
msgstr "Платформамызда іске қосылған шақырулардан мысалдар"

#: taklif/templates/taklif/bosh_sahifa.html:258
msgid "Qanday ishlaydi?"
msgstr "Қалай жұмыс істейді?"

#: taklif/templates/taklif/bosh_sahifa.html:259
msgid "Uch oddiy qadam — va taklifnomangiz tayyor"
msgstr "Үш қарапайым қадам — және шақыруыңыз дайын"

#: taklif/templates/taklif/bosh_sahifa.html:264
msgid "Dizayn tanlang"
msgstr "Дизайн таңдаңыз"

#: taklif/templates/taklif/bosh_sahifa.html:265
msgid ""
"Bir nechta tayyor shablondan o'zingizga yoqqanini tanlang — har biri o'ziga "
"xos uslubda."
msgstr "Бірнеше дайын үлгіден ұнағанын таңдаңыз — әрқайсысы өзіндік стильде."

#: taklif/templates/taklif/bosh_sahifa.html:269
msgid "Ma'lumotlarni to'ldiring"
msgstr "Деректерді толтырыңыз"

#: taklif/templates/taklif/bosh_sahifa.html:270
msgid ""
"Marosim turi, ismlar, sana, manzil, rasmlar va musiqa — hammasini o'zingiz "
"kiritasiz."
msgstr ""
"Іс-шара түрі, есімдер, күні, мекенжай, суреттер мен музыка — бәрін өзіңіз "
"енгізесіз."

#: taklif/templates/taklif/bosh_sahifa.html:274
msgid "Ulashing"
msgstr "Бөлісіңіз"

#: taklif/templates/taklif/bosh_sahifa.html:275
msgid ""
"Tayyor taklifnomani ko'rib chiqing, yoqsa faollashtiring va yaqinlaringizga "
"Telegram yoki Instagram orqali yuboring."
msgstr ""
"Дайын шақыруды қараңыз, ұнаса іске қосыңыз және жақындарыңызға Telegram "
"немесе Instagram арқылы жіберіңіз."

#: taklif/templates/taklif/bosh_sahifa.html:287
msgid "Dizayn shablonlari"
msgstr "Дизайн үлгілері"

#: taklif/templates/taklif/bosh_sahifa.html:288
msgid "Tanlang va shu zahoti o'zingiznikini yaratib ko'ring"
msgstr "Таңдаңыз да, бірден өзіңіздікін жасап көріңіз"

#: taklif/templates/taklif/bosh_sahifa.html:291
#: taklif/templates/taklif/shablon_tanlash.html:33
msgid "Barchasi"
msgstr "Барлығы"

#: taklif/templates/taklif/bosh_sahifa.html:309
#: taklif/templates/taklif/shablon_tanlash.html:51
msgid "so'm"
msgstr "сум"

#: taklif/templates/taklif/bosh_sahifa.html:332
msgid "Savol-javob"
msgstr "Сұрақ-жауап"

#: taklif/templates/taklif/bosh_sahifa.html:333
msgid "Ko'p so'raladigan savollar"
msgstr "Жиі қойылатын сұрақтар"

#: taklif/templates/taklif/bosh_sahifa.html:337
msgid "To'lovni qanday amalga oshiraman?"
msgstr "Төлемні қалай төлеймін?"

#: taklif/templates/taklif/bosh_sahifa.html:338
msgid ""
"Avval taklifnomangizni bepul yaratib, uni to'liq ko'rib chiqasiz. Yoqsa, "
"taklifnoma sahifasidagi \"Yoqdi\" tugmasini bosing — shu orqali sizni "
"to'g'ridan-to'g'ri Telegram'dagi adminimiz bilan bog'laymiz va to'lov "
"tafsilotlarini o'sha yerda kelishasiz. To'lov tasdiqlangach, taklifnomangiz "
"faollashtiriladi."
msgstr ""
"Алдымен шақыруыңызды тегін жасап, оны толық қарап шығасыз. Ұнаса, шақыру "
"бетіндегі «Ұнады» түймесін басыңыз — бұл сізді тікелей Telegram-дағы "
"әкімшімізбен байланыстырады, сол жерде төлем егжей-тегжейін келісесіз. Төлем"
" расталғаннан кейін шақыруыңыз белсендіріледі."

#: taklif/templates/taklif/bosh_sahifa.html:341
msgid "Ro'yxatdan o'tishim yoki parol o'ylab topishim kerakmi?"
msgstr "Тіркелуім немесе құпия сөз ойлап табуым керек пе?"

#: taklif/templates/taklif/bosh_sahifa.html:342
msgid ""
"Yo'q. Hech qanday ro'yxatdan o'tish, email yoki parol talab qilinmaydi — "
"dizaynni tanlab, ma'lumotlaringizni kiritasiz, xolos. \"Mening "
"taklifnomalarim\" bo'limi orqali shu brauzeringizda yaratgan barcha "
"taklifnomalaringizni istalgan vaqt qayta topishingiz mumkin."
msgstr ""
"Жоқ. Ешқандай тіркелу, электрондық пошта немесе құпия сөз қажет емес — сіз "
"тек дизайнды таңдап, деректеріңізді енгізесіз. «Менің шақыруларым» бөлімі "
"арқылы осы браузерде жасаған барлық шақыруларыңызды кез келген уақытта қайта"
" таба аласыз."

#: taklif/templates/taklif/bosh_sahifa.html:345
msgid "Ma'lumotlarda xato qilib qo'ysam, tuzata olamanmi?"
msgstr "Деректерде қате жіберсем, түзете аламын ба?"

#: taklif/templates/taklif/bosh_sahifa.html:346
msgid ""
"Ha. Xuddi shu ism bilan formani qayta to'ldirsangiz, tizim avvalgi "
"taklifnomangizni taniydi va uni yangilashni yoki alohida saqlashni so'raydi."
" Kattaroq o'zgarish yoki muammo bo'lsa, taklifnoma sahifasidagi \"Yoqdi\" "
"tugmasi orqali to'g'ridan-to'g'ri adminimizga yozishingiz mumkin."
msgstr ""
"Иә. Формаға сол аттармен қайта толтырсаңыз, жүйе алдыңғы шақыруыңызды таниды"
" және оны жаңартуды немесе бөлек сақтауды сұрайды. Үлкенірек өзгеріс немесе "
"мәселе болса, шақыру бетіндегі «Ұнады» түймесі арқылы тікелей әкімшімізге "
"жаза аласыз."

#: taklif/templates/taklif/bosh_sahifa.html:349
msgid "Taklifnoma linki qachon tugaydi?"
msgstr "Шақыру сілтемесінің мерзімі бітеді ме?"

#: taklif/templates/taklif/bosh_sahifa.html:350
msgid ""
"Avtomatik tugamaydi — to'y yoki marosim o'tib ketgandan keyin ham link "
"ishlab turadi. Uni faolsizlantirish kerak bo'lsa, faqat qo'lda (admin "
"panelidan) qilinadi."
msgstr ""
"Автоматты түрде аяқталмайды — той немесе шара өтіп кеткеннен кейін де "
"сілтеме жұмыс істей береді. Оны сөндіру тек қолмен, әкімшілік панелінен ғана"
" жасалады."

#: taklif/templates/taklif/bosh_sahifa.html:353
msgid "Mehmonlarim javobini (kelaman/kelolmayman) kuzatib borsam bo'ladimi?"
msgstr "Қонақтарымның жауабын (келеді/келмейді) қадағалай аламын ба?"

#: taklif/templates/taklif/bosh_sahifa.html:354
msgid ""
"Ha. Har bir taklifnomaning faqat sizga ko'rinadigan maxfiy statistika "
"sahifasi bor — u yerda nechta kishi ko'rgani, kim \"kelaman\" yoki "
"\"kelolmayman\" deb javob bergani va mehmonlarga bergan shaxsiy "
"linklaringizni kim ko'rib-ko'rmaganini kuzatib borasiz. Havolasini "
"\"Taklifnomangiz tayyor!\" sahifasida topasiz."
msgstr ""
"Иә. Әрбір шақырудың тек сізге ғана көрінетін жеке статистика беті бар — онда"
" неше адам көргенін, кім «келемін» немесе «келмеймін» деп жауап бергенін "
"және қонақтарға берген жеке сілтемелерді кім көріп, кім көрмегенін қадағалай"
" аласыз. Сілтемені «Шақыруыңыз дайын!» бетінен табасыз."

#: taklif/templates/taklif/bosh_sahifa.html:357
msgid "Nechta rasm va qanday musiqa qo'sha olaman?"
msgstr "Қанша сурет және қандай әуен қоса аламын?"

#: taklif/templates/taklif/bosh_sahifa.html:358
msgid ""
"Taklifnomangizga eng ko'pi bilan 2 ta o'z rasmingizni (har biri 8 MB gacha) "
"yoki tayyor namunalardan tanlab qo'shishingiz mumkin. Musiqa uchun ham "
"o'zingiznikini yuklashingiz (15 MB gacha) yoki tayyor variantlardan birini "
"tanlashingiz mumkin."
msgstr ""
"Сіз өзіңіздің 2 суретіңізге дейін (әрқайсысы 8 МБ дейін) қоса аласыз немесе "
"дайын үлгілерден таңдай аласыз. Әуен үшін де өзіңізді жүктеуге (15 МБ дейін)"
" немесе дайын нұсқалардың бірін таңдауға болады."

#: taklif/templates/taklif/bosh_sahifa.html:361
msgid "Qaysi tillarda ishlaydi?"
msgstr "Қандай тілдерде жұмыс істейді?"

#: taklif/templates/taklif/bosh_sahifa.html:362
msgid ""
"Sayt 8 tilda ishlaydi: o'zbek, rus, ingliz, tojik, qozoq, qirg'iz, turkman "
"va qoraqalpoq. Til tanlash tugmasi har bir sahifaning yuqori qismida "
"joylashgan."
msgstr ""
"Сайт 8 тілде жұмыс істейді: өзбекше, орысша, ағылшынша, тәжікше, қазақша, "
"қырғызша, түрікменше және қарақалпақша. Тіл ауыстырғыш әр беттің жоғарғы "
"жағында орналасқан."

#: taklif/templates/taklif/faollashtirilmagan.html:4
msgid "Taklifnoma hali faollashtirilmagan"
msgstr "Шақыру әлі белсендірілмеген"

#: taklif/templates/taklif/faollashtirilmagan.html:21
msgid "Bu taklifnoma sahifasi hali tayyor emas"
msgstr "Бұл шақыру беті әлі дайын емес"

#: taklif/templates/taklif/faollashtirilmagan.html:22
msgid ""
"Bu havola hozircha faollashtirilmagan. Iltimos, taklifnoma egasi bilan "
"bog'laning."
msgstr "Бұл сілтеме әлі белсендірілмеген. Шақыру иесіне хабарласыңыз."

#: taklif/templates/taklif/mening_taklifnomalarim.html:40
