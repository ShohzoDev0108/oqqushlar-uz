#: taklif/templates/taklif/yaratish.html:69
msgid "shabloni"
msgstr "үлгісі"

#: taklif/templates/taklif/yaratish.html:71
msgid ""
"Ma'lumotlaringizni to'ldiring. Yuborgach — taklifnomangiz shu zahoti tayyor "
"bo'ladi (hali hech kimga ochiq emas)."
msgstr ""
"Деректеріңізді толтырыңыз. Жібергеннен кейін шақыру хатыңыз дереу дайын "
"болады (әзірге ешкімге көрінбейді)."

#: taklif/templates/taklif/yaratish.html:80
#, python-format
msgid ""
"Sizda <strong>%(ism1)s %(ism2)s</strong> nomi bilan taklifnoma allaqachon "
"bor (shu brauzerda avval yaratilgan)."
msgstr ""
"Сізде <strong>%(ism1)s %(ism2)s</strong> есімдерімен шақыру хаты бар екен "
"(осы браузерде бұрын жасалған)."

#: taklif/templates/taklif/yaratish.html:81
msgid "Nima qilamiz?"
msgstr "Не істейміз?"

#: taklif/templates/taklif/yaratish.html:83
msgid "Buni yangilayman (eskisi o'chadi)"
msgstr "Осыны жаңартамын (ескісі өшеді)"

#: taklif/templates/taklif/yaratish.html:84
msgid "Yo'q, alohida saqlayman"
msgstr "Жоқ, бөлек сақтаймын"

#: taklif/templates/taklif/yaratish.html:103
#, python-format
msgid "Rasmlar (eng ko'pi bilan %(soni)s ta, ixtiyoriy)"
msgstr "Суреттер (ең көбі %(soni)s дана, міндетті емес)"

#: taklif/templates/taklif/yaratish.html:105
msgid "O'z fotoyingiz hali bo'lmasa, tayyor namunalardan tanlashingiz mumkin:"
msgstr "Егер өз суретіңіз әлі болмаса, дайын үлгілерден таңдай аласыз:"

#: taklif/templates/taklif/yaratish.html:110
#, python-format
msgid "Namuna rasm %(soni)s"
msgstr "Үлгі сурет %(soni)s"

#: taklif/templates/taklif/yaratish.html:115
msgid "yoki"
msgstr "немесе"

#: taklif/templates/taklif/yaratish.html:117
msgid "O'zingizning rasmingizni yuklang"
msgstr "Өз суретіңізді жүктеңіз"

#: taklif/templates/taklif/yaratish.html:131
msgid "Taklifnomani yaratish"
msgstr "Шақыруды жасау"

#: taklif/templates/taklif/yaratish.html:135
msgid "Boshqa shablon tanlash"
msgstr "Басқа үлгі таңдау"

#: taklif/templates/taklif/yaratish.html:178
#, python-format
msgid ""
"Eng ko'pi bilan %(soni)s ta rasm tanlashingiz mumkin. Iltimos, qaytadan "
"tanlang."
msgstr "Ең көбі %(soni)s сурет таңдай аласыз. Қайта таңдаңыз."

#: taklif/validators.py:29
#, python-format
msgid ""
"Fayl hajmi %(maks)s MB dan katta bo'lmasligi kerak (yuklangan fayl: "
"%(hajm).1f MB)."
msgstr ""
"Файл өлшемі %(maks)s МБ-дан аспауы керек (жүктелген файл: %(hajm).1f МБ)."

#: taklif/views.py:138
#, python-format
msgid ""
"\"%(nomi)s\" fayli juda katta (%(hajm).1f MB). Rasm hajmi %(maks)s MB dan "
"oshmasligi kerak."
msgstr ""
"\"%(nomi)s\" файлы тым үлкен (%(hajm).1f МБ). Сурет өлшемі %(maks)s МБ-дан "
"аспауы керек."

#: taklif/views.py:521
msgid "Iltimos, ismingizni kiriting."
msgstr "Атыңызды енгізіңіз."

#: taklif/views.py:568
msgid "Javobingiz uchun rahmat!"
msgstr "Жауабыңыз үшін рахмет!"

#: taklif/views.py:614
msgid "Bu taklifnomani o'chira olmaysiz."
msgstr "Сіз бұл шақыруды жоя алмайсыз."

#: taklif/views.py:625
#, python-format
msgid ""
"\"%(nomi)s\" taklifnomasi o'chirildi. Bu faollashtirilgan taklifnoma "
"bo'lgani uchun ma'lumotlari %(kun)s kun davomida saqlanadi — agar xato "
"bosgan bo'lsangiz, administratorga murojaat qiling."
msgstr ""
"\"%(nomi)s\" шақыруы жойылды. Бұл белсендірілген шақыру болғандықтан, "
"деректері %(kun)s күн бойы сақталады — қате басып қалсаңыз, әкімшіге "
"хабарласыңыз."

#: taklif/views.py:632
#, python-format
msgid "\"%(nomi)s\" taklifnomasi o'chirildi."
msgstr "\"%(nomi)s\" шақыруы жойылды."

#: taklif/views.py:687
msgid "Iltimos, mehmon ismini kiriting."
msgstr "Қонақтың атын енгізіңіз."

#: taklif/views.py:690
#, python-format
msgid "\"%(ism)s\" uchun shaxsiy link yaratildi."
msgstr "\"%(ism)s\" үшін жеке сілтеме жасалды."

#: taklif/views.py:699
msgid "Mehmon o'chirildi."
msgstr "Қонақ жойылды."

#: taklif/views.py:713
msgid "Tilak endi taklifnoma sahifasida hammaga ko'rinadi."
msgstr "Тілек енді шақыру бетінде барлығына көрінеді."

#: taklif/views.py:715
msgid "Tilak yashirildi — endi faqat sizga ko'rinadi."
msgstr "Тілек жасырылды — енді тек сізге көрінеді."

#: templates/404.html:4
msgid "Sahifa topilmadi"
msgstr "Бет табылмады"

#: templates/404.html:35
msgid "Bunday sahifa topilmadi"
msgstr "Мұндай бет табылмады"

#: templates/404.html:36
msgid "Havola noto'g'ri yoki bu sahifa endi mavjud emas."
msgstr "Сілтеме қате немесе бұл бет енді жоқ."

#: templates/404.html:37 templates/500.html:38
msgid "Bosh sahifaga qaytish"
msgstr "Басты бетке қайту"

#: templates/500.html:7
msgid "Xatolik yuz berdi"
msgstr "Қате орын алды"

#: templates/500.html:36
msgid "Kechirasiz, xatolik yuz berdi"
msgstr "Кешіріңіз, қате орын алды"

#: templates/500.html:37
msgid ""
"Sahifa vaqtincha ishlamayapti. Iltimos, birozdan so'ng qayta urinib ko'ring."
msgstr "Бет уақытша жұмыс істемей тұр. Аздан кейін қайта көріңіз."

