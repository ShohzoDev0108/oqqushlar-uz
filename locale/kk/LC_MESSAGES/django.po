msgstr "күн"

msgid "soat"
msgstr "сағат"

msgid "minut"
msgstr "минут"

msgid "sekund"
msgstr "секунд"

msgid "Marosim kalendari"
msgstr "Мереке күнтізбесі"

msgid "Du Se Ch Pa Ju Sh Ya"
msgstr "Дс Сс Ср Бс Жм Сб Жк"

msgid "Fotolavha"
msgstr "Фотогалерея"

msgid "Tadbir tafsilotlari"
