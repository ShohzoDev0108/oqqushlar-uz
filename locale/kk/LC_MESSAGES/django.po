msgstr "Басқа үлгі таңдау"

#: taklif/templates/taklif/yaratish.html:651
#, python-format
msgid ""
"Eng ko'pi bilan %(soni)s ta rasm tanlashingiz mumkin. Iltimos, qaytadan "
"tanlang."
msgstr "Ең көбі %(soni)s сурет таңдай аласыз. Қайта таңдаңыз."

#: taklif/templates/taklif/yaratish.html:782
msgid "Fayl tanlash"
msgstr "Файл таңдау"

#: taklif/templates/taklif/yaratish.html:783
msgid "Fayl tanlanmagan"
msgstr "Файл таңдалмаған"

#: taklif/templates/taklif/yaratish.html:784
msgid "ta fayl tanlandi"
msgstr "файл таңдалды"

#: taklif/validators.py:29
#, python-format
msgid ""
"Fayl hajmi %(maks)s MB dan katta bo'lmasligi kerak (yuklangan fayl: "
"%(hajm).1f MB)."
msgstr ""
"Файл өлшемі %(maks)s МБ-дан аспауы керек (жүктелген файл: %(hajm).1f МБ)."

#: taklif/views.py:153
#, python-format
msgid ""
"\"%(nomi)s\" fayli juda katta (%(hajm).1f MB). Rasm hajmi %(maks)s MB dan "
"oshmasligi kerak."
msgstr ""
"\"%(nomi)s\" файлы тым үлкен (%(hajm).1f МБ). Сурет өлшемі %(maks)s МБ-дан "
"аспауы керек."

#: taklif/views.py:651
msgid "Iltimos, ismingizni kiriting."
msgstr "Атыңызды енгізіңіз."

#: taklif/views.py:698
msgid "Javobingiz uchun rahmat!"
msgstr "Жауабыңыз үшін рахмет!"

#: taklif/views.py:744
msgid "Bu taklifnomani o'chira olmaysiz."
msgstr "Сіз бұл шақыруды жоя алмайсыз."

#: taklif/views.py:755
#, python-format
msgid ""
"\"%(nomi)s\" taklifnomasi o'chirildi. Bu faollashtirilgan taklifnoma "
"bo'lgani uchun ma'lumotlari %(kun)s kun davomida saqlanadi — agar xato "
"bosgan bo'lsangiz, administratorga murojaat qiling."
msgstr ""
"\"%(nomi)s\" шақыруы жойылды. Бұл белсендірілген шақыру болғандықтан, "
"деректері %(kun)s күн бойы сақталады — қате басып қалсаңыз, әкімшіге "
"хабарласыңыз."

#: taklif/views.py:762
#, python-format
msgid "\"%(nomi)s\" taklifnomasi o'chirildi."
msgstr "\"%(nomi)s\" шақыруы жойылды."

#: taklif/views.py:817
msgid "Iltimos, mehmon ismini kiriting."
msgstr "Қонақтың атын енгізіңіз."

#: taklif/views.py:820
#, python-format
msgid "\"%(ism)s\" uchun shaxsiy link yaratildi."
msgstr "\"%(ism)s\" үшін жеке сілтеме жасалды."

#: taklif/views.py:829
msgid "Mehmon o'chirildi."
msgstr "Қонақ жойылды."

#: taklif/views.py:843
msgid "Tilak endi taklifnoma sahifasida hammaga ko'rinadi."
msgstr "Тілек енді шақыру бетінде барлығына көрінеді."

#: taklif/views.py:845
msgid "Tilak yashirildi — endi faqat sizga ko'rinadi."
msgstr "Тілек жасырылды — енді тек сізге көрінеді."

#: templates/404.html:4
