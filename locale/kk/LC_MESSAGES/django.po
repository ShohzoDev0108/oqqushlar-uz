msgstr "Келесіз бе?"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:210
msgid "Ha, albatta kelaman"
msgstr "Иә, міндетті түрде келемін"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:211
msgid "Afsuski, kela olmayman"
msgstr "Өкінішке орай, келе алмаймын"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:214
msgid "Izoh (ixtiyoriy)"
msgstr "Пікір (міндетті емес)"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:217
msgid "Yuborish"
msgstr "Жіберу"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:223
