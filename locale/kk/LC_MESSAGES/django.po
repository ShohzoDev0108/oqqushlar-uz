msgstr "Telegram тобы"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:244
msgid "Do'stlaringizga ulashing"
msgstr "Достарыңызбен бөлісіңіз"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:246
msgid "Taklifnomani yaqinlaringizga ham yuboring"
msgstr "Шақыруды жақындарыңызға да жіберіңіз"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:252
msgid "Havolani nusxalash"
msgstr "Сілтемені көшіру"

#: taklif/templates/taklif/shablonlar/_konvert_parda.html:12
