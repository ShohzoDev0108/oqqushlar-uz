msgstr "Уақыты"

msgid "To'yxona"
msgstr "Той залы"

msgid "Kiyinish kodi"
msgstr "Киім коды"

msgid "Tabrik sovg'asi"
msgstr "Сыйлық"

msgid ""
"Ishtirokingiz — biz uchun eng qadrli sovg'a. Agar tabrik sovg'a qoldirmoqchi"
" bo'lsangiz:"
msgstr ""
"Сіздің қатысуыңыз — біз үшін ең қымбат сыйлық. Егер ақшалай сыйлық "
"қалдырғыңыз келсе:"

msgid "Nusxalandi!"
msgstr "Көшірілді!"

msgid "RSVP — kelasizmi?"
msgstr "RSVP — келесіз бе?"

msgid "Ismingiz"
msgstr "Атыңыз"

msgid "Nechta kishi bo'lasiz?"
msgstr "Неше адам боласыздар?"

msgid "1 dan 5 gacha"
msgstr "1-ден 5-ке дейін"

msgid "Kelasizmi?"
msgstr "Келесіз бе?"

msgid "Ha, albatta kelaman"
msgstr "Иә, міндетті түрде келемін"

msgid "Afsuski, kela olmayman"
msgstr "Өкінішке орай, келе алмаймын"

msgid "Izoh (ixtiyoriy)"
msgstr "Пікір (міндетті емес)"

msgid "Yuborish"
msgstr "Жіберу"

