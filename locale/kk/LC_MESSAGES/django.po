msgstr "Үлкейтіп көру"

#: taklif/templates/taklif/yaratish.html:309
msgid "yoki"
msgstr "немесе"

#: taklif/templates/taklif/yaratish.html:311
msgid "O'zingizning rasmingizni yuklang"
msgstr "Өз суретіңізді жүктеңіз"

#: taklif/templates/taklif/yaratish.html:325
msgid "Taklifnomani yaratish"
msgstr "Шақыруды жасау"

#: taklif/templates/taklif/yaratish.html:329
