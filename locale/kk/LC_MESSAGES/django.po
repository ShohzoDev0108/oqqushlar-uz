msgstr "Қонақтар"

#, python-format
msgid "Hozircha <strong>%(soni)s</strong> kishi kelishini tasdiqladi"
msgstr "Қазірге дейін <strong>%(soni)s</strong> адам келетінін растады"

#, python-format
msgid "%(soni)s kishi"
msgstr "%(soni)s адам"

msgid "Yangiliklar va suratlar uchun Telegram guruhimizga qo'shiling"
msgstr "Жаңалықтар мен суреттер үшін Telegram тобымызға қосылыңыз"

msgid "Telegram guruhi"
msgstr "Telegram тобы"

msgid "Do'stlaringizga ulashing"
msgstr "Достарыңызбен бөлісіңіз"

msgid "Taklifnomani yaqinlaringizga ham yuboring"
msgstr "Шақыруды жақындарыңызға да жіберіңіз"

msgid "Havolani nusxalash"
msgstr "Сілтемені көшіру"

#, python-format
msgid "Hurmatli %(ism)s, sizga taklifnoma keldi"
msgstr "Құрметті %(ism)s, сізге шақыру келді"

msgid "Sizga taklifnoma keldi"
msgstr "Сізге шақыру келді"

msgid "Taklifnomani ochish"
msgstr "Шақыруды ашу"

msgid "Bu — sizning shaxsiy oldindan ko'rish havolangiz, hali ommaviy emas."
msgstr "Бұл — сіздің жеке алдын ала қарау сілтемеңіз, әлі жария емес."

msgid "Faollashtirish uchun Telegram orqali"
msgstr "Іске қосу үшін Telegram арқылы"

msgid "bilan bog'laning."
msgstr "хабарласыңыз."

msgid "Yoqdi (yuborildi)"
msgstr "Ұнады (жіберілді)"

msgid "Yoqdi — adminga yozish"
msgstr "Ұнады — әкімшіге жазу"

msgid "Qayta yaratish"
msgstr "Қайта жасау"

msgid "Baxtli oilamizga"
msgstr "Бақытты болғанымызға"

msgid "yil"
msgstr "жыл"

msgid "bo'ldi"
msgstr "болды"

msgid "Marosimgacha"
msgstr "Іс-шараға дейін"

msgid "taklifnomasi"
msgstr "шақыруы"

msgid "Statistika"
msgstr "Статистика"

msgid "Ochiq sahifani ko'rish"
msgstr "Шақыруды қарау"

#, python-format
msgid "%(nomi)s — statistika"
msgstr "%(nomi)s — статистика"

msgid "Bu sahifa faqat sizga ko'rinadi. Linkni hech kimga yubormang."
msgstr "Бұл бет тек сізге ғана көрінеді. Сілтемені ешкімге жібермеңіз."

msgid "ko'rishlar"
msgstr "қаралымдар"

msgid "javoblar"
msgstr "жауаптар"

msgid "keladi (mehmon)"
msgstr "келеді (қонақ)"

msgid "kelmaydi"
msgstr "келмейді"

msgid "Ism"
msgstr "Аты"

msgid "Holat"
msgstr "Күйі"

msgid "Mehmonlar soni"
msgstr "Қонақтар саны"

msgid "Izoh"
msgstr "Пікір"

msgid "Keladi"
msgstr "Келеді"

msgid "Kelmaydi"
msgstr "Келмейді"

msgid "Hozircha javoblar yo'q."
msgstr "Әзірге жауап жоқ."

msgid "Mehmonlar uchun shaxsiy linklar"
msgstr "Қонақтар үшін жеке сілтемелер"

msgid ""
"Admin panelda qo'shilgan har bir mehmonga shaxsiy link — shu linkni "
"Telegram/Instagram orqali o'sha mehmonning o'ziga yuboring."
msgstr ""
"Әкімшілік панелінде қосылған әр қонаққа арналған жеке сілтеме — осы "
"сілтемені Telegram/Instagram арқылы сол қонаққа жіберіңіз."

msgid "Ko'rdimi"
msgstr "Көрді ме?"

msgid "Link"
msgstr "Сілтеме"

msgid "ko'rdi"
msgstr "көрді"

msgid "hali ko'rmagan"
msgstr "әлі көрген жоқ"

msgid ""
"Hali mehmon qo'shilmagan. Admin panelda taklifnoma ichida \"Mehmonlar\" "
"bo'limidan qo'shing."
msgstr ""
"Әзірге қонақ қосылмаған. Оларды әкімшілік панеліндегі шақыру ішіндегі "
"«Қонақтар» бөлімінен қосыңыз."

msgid "Tayyor!"
msgstr "Дайын!"

msgid "Taklifnomangiz tayyor!"
msgstr "Шақыруыңыз дайын!"

msgid "Bu — sizning shaxsiy havolangiz. Mehmonlaringizga shuni yuborasiz:"
msgstr "Бұл — сіздің жеке сілтемеңіз. Оны қонақтарыңызға жіберіңіз:"

msgid "Nusxalash"
msgstr "Көшіру"

msgid "Taklifnomani ko'rish"
msgstr "Шақыруды қарау"

msgid ""
"Yuqoridagi tugma orqali taklifnomangizni ko'rib, hammasi to'g'ri ekanligiga "
"ishonch hosil qiling."
msgstr ""
"Жоғарыдағы түйме арқылы шақыруыңызды қарап, бәрі дұрыс екеніне көз "
"жеткізіңіз."

#, python-format
msgid ""
"Yoqsa — taklifnoma sahifasidagi <strong>\"Yoqdi\"</strong> tugmasini bosing,"
" shu orqali to'g'ridan-to'g'ri Telegram orqali <strong>%(admin)s</strong> "
"bilan bog'lanib to'lovni amalga oshirasiz."
msgstr ""
"Ұнаса — шақыру бетіндегі <strong>«Ұнады»</strong> түймесін басыңыз: осылайша"
" Telegram арқылы тікелей <strong>%(admin)s</strong>-пен байланысып, төлем "
"жасайсыз."

msgid ""
"To'lov tasdiqlangach, taklifnomangiz faollashtiriladi va uni "
"mehmonlaringizga (Telegram, Instagram va h.k.) yuborishingiz mumkin bo'ladi."
msgstr ""
"Төлем расталғаннан кейін шақыруыңыз іске қосылады және оны қонақтарға жібере"
" аласыз (Telegram, Instagram және т.б.)."

msgid "shabloni"
msgstr "үлгісі"

msgid ""
"Ma'lumotlaringizni to'ldiring. Yuborgach — taklifnomangiz shu zahoti tayyor "
"bo'ladi (hali hech kimga ochiq emas)."
msgstr ""
"Деректеріңізді толтырыңыз. Жібергеннен кейін шақыру хатыңыз дереу дайын "
"болады (әзірге ешкімге көрінбейді)."

#, python-format
msgid ""
"Sizda <strong>%(ism1)s %(ism2)s</strong> nomi bilan taklifnoma allaqachon "
"bor (shu brauzerda avval yaratilgan)."
msgstr ""
"Сізде <strong>%(ism1)s %(ism2)s</strong> есімдерімен шақыру хаты бар екен "
"(осы браузерде бұрын жасалған)."

msgid "Nima qilamiz?"
msgstr "Не істейміз?"

msgid "Buni yangilayman (eskisi o'chadi)"
msgstr "Осыны жаңартамын (ескісі өшеді)"

msgid "Yo'q, alohida saqlayman"
msgstr "Жоқ, бөлек сақтаймын"

#, python-format
msgid "Rasmlar (eng ko'pi bilan %(soni)s ta, ixtiyoriy)"
msgstr "Суреттер (ең көбі %(soni)s дана, міндетті емес)"

msgid "O'z fotoyingiz hali bo'lmasa, tayyor namunalardan tanlashingiz mumkin:"
msgstr "Егер өз суретіңіз әлі болмаса, дайын үлгілерден таңдай аласыз:"

#, python-format
msgid "Namuna rasm %(soni)s"
msgstr "Үлгі сурет %(soni)s"

msgid "yoki"
msgstr "немесе"

msgid "O'zingizning rasmingizni yuklang"
msgstr "Өз суретіңізді жүктеңіз"

msgid "Taklifnomani yaratish"
msgstr "Шақыруды жасау"

msgid "Boshqa shablon tanlash"
msgstr "Басқа үлгі таңдау"

#, python-format
msgid ""
"Eng ko'pi bilan %(soni)s ta rasm tanlashingiz mumkin. Iltimos, qaytadan "
"tanlang."
msgstr "Ең көбі %(soni)s сурет таңдай аласыз. Қайта таңдаңыз."

#, python-format
msgid ""
"Fayl hajmi %(maks)s MB dan katta bo'lmasligi kerak (yuklangan fayl: "
"%(hajm).1f MB)."
msgstr ""
"Файл өлшемі %(maks)s МБ-дан аспауы керек (жүктелген файл: %(hajm).1f МБ)."

#, python-format
msgid ""
"\"%(nomi)s\" fayli juda katta (%(hajm).1f MB). Rasm hajmi %(maks)s MB dan "
"oshmasligi kerak."
msgstr ""
"\"%(nomi)s\" файлы тым үлкен (%(hajm).1f МБ). Сурет өлшемі %(maks)s МБ-дан "
"аспауы керек."

msgid "Iltimos, ismingizni kiriting."
msgstr "Атыңызды енгізіңіз."

msgid "Javobingiz uchun rahmat!"
msgstr "Жауабыңыз үшін рахмет!"

msgid "Bu taklifnomani o'chira olmaysiz."
msgstr "Сіз бұл шақыруды жоя алмайсыз."

#, python-format
msgid ""
"\"%(nomi)s\" taklifnomasi o'chirildi. Bu faollashtirilgan taklifnoma "
"bo'lgani uchun ma'lumotlari %(kun)s kun davomida saqlanadi — agar xato "
"bosgan bo'lsangiz, administratorga murojaat qiling."
msgstr ""
"\"%(nomi)s\" шақыруы жойылды. Бұл белсендірілген шақыру болғандықтан, "
"деректері %(kun)s күн бойы сақталады — қате басып қалсаңыз, әкімшіге "
"хабарласыңыз."

#, python-format
msgid "\"%(nomi)s\" taklifnomasi o'chirildi."
msgstr "\"%(nomi)s\" шақыруы жойылды."

msgid "Sahifa topilmadi"
msgstr "Бет табылмады"

msgid "Bunday sahifa topilmadi"
msgstr "Мұндай бет табылмады"

msgid "Havola noto'g'ri yoki bu sahifa endi mavjud emas."
msgstr "Сілтеме қате немесе бұл бет енді жоқ."

msgid "Bosh sahifaga qaytish"
msgstr "Басты бетке қайту"

msgid "Xatolik yuz berdi"
msgstr "Қате орын алды"

msgid "Kechirasiz, xatolik yuz berdi"
msgstr "Кешіріңіз, қате орын алды"

msgid ""
"Sahifa vaqtincha ishlamayapti. Iltimos, birozdan so'ng qayta urinib ko'ring."
msgstr "Бет уақытша жұмыс істемей тұр. Аздан кейін қайта көріңіз."

#, python-format
msgid "Sizni %(sana)s kunidagi marosimimizga taklif qilamiz"
msgstr "Сізді %(sana)s күнгі тойымызға шақырамыз"

msgid "Oqqushlar — chiroyli elektron taklifnomalar"
msgstr "Oqqushlar — әдемі электрондық шақыру хаттары"

msgid ""
"O'zbekiston uchun eng chiroyli va zamonaviy elektron taklifnomalar. Bir "
"necha daqiqada yarating."
msgstr ""
"Өзбекстан үшін ең әдемі және заманауи электрондық шақыру хаттары. Бірнеше "
"минутта жасаңыз."

#~ msgid "Admin panel"
#~ msgstr "Әкімші панелі"

#~ msgid "O'zbekiston uchun"
#~ msgstr "Өзбекстан үшін"

#~ msgid "ta noyob dizayn"
#~ msgstr "бірегей дизайн"

