msgstr "Іске қосылған"

#: taklif/templates/taklif/mening_taklifnomalarim.html:54
msgid "To'lov kutilmoqda"
msgstr "Төлем күтілуде"

#: taklif/templates/taklif/mening_taklifnomalarim.html:57
msgid "Ko'rish"
msgstr "Қарау"

#: taklif/templates/taklif/mening_taklifnomalarim.html:59
msgid "Yoqdi"
msgstr "Ұнады"

#: taklif/templates/taklif/mening_taklifnomalarim.html:66
msgid "Siz hali hech qanday taklifnoma yaratmagansiz."
msgstr "Сіз әлі ешқандай шақыру жасаған жоқсыз."

#: taklif/templates/taklif/muddati_tugagan.html:4
