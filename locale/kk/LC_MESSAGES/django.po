msgstr "%(soni)s адам"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:237
msgid "Yangiliklar va suratlar uchun Telegram guruhimizga qo'shiling"
msgstr "Жаңалықтар мен суреттер үшін Telegram тобымызға қосылыңыз"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:238
