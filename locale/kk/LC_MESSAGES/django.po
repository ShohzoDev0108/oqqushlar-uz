#: taklif/templates/taklif/shablon_tanlash.html:4
#: taklif/templates/taklif/shablon_tanlash.html:34
msgid "Shablon tanlang"
msgstr "Үлгі таңдаңыз"

#: taklif/templates/taklif/shablon_tanlash.html:36
msgid ""
"Sizga yoqqan dizaynni tanlang — keyingi bosqichda o'z ma'lumotlaringizni "
