msgstr "Урматтуу %(ism)s, сизге чакыруу келди"

msgid "Sizga taklifnoma keldi"
msgstr "Сизге чакыруу келди"

msgid "Taklifnomani ochish"
msgstr "Чакырууну ачуу"

msgid "Bu — sizning shaxsiy oldindan ko'rish havolangiz, hali ommaviy emas."
msgstr ""
"Бул — сиздин жеке алдын ала көрүү шилтемеңиз, ал азырынча жалпыга ачык эмес."

msgid "Faollashtirish uchun Telegram orqali"
msgstr "Активдештирүү үчүн Telegram аркылуу"

msgid "bilan bog'laning."
msgstr "байланышыңыз."

msgid "Yoqdi (yuborildi)"
msgstr "Жактырылды (жөнөтүлдү)"

msgid "Yoqdi — adminga yozish"
msgstr "Жактырылды — админге жазуу"

msgid "Qayta yaratish"
msgstr "Кайра түзүү"

msgid "Baxtli oilamizga"
msgstr "Бактылуу үй-бүлө болгонубузга"

