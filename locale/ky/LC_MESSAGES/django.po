msgstr "Канча адам болосуздар?"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:205
msgid "1 dan 5 gacha"
msgstr "1ден 5ке чейин"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:207
msgid "Kelasizmi?"
msgstr "Келесизби?"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:210
msgid "Ha, albatta kelaman"
msgstr "Ооба, сөзсүз келем"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:211
msgid "Afsuski, kela olmayman"
msgstr "Тилекке каршы, келе албайм"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:214
