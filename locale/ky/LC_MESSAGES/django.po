msgstr "Коноктор"

#, python-format
msgid "Hozircha <strong>%(soni)s</strong> kishi kelishini tasdiqladi"
msgstr "Азырынча <strong>%(soni)s</strong> адам келерин тастыктады"

#, python-format
msgid "%(soni)s kishi"
msgstr "%(soni)s адам"

msgid "Yangiliklar va suratlar uchun Telegram guruhimizga qo'shiling"
msgstr "Жаңылыктар жана сүрөттөр үчүн Telegram тобубузга кошулуңуз"

