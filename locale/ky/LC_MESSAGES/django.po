" келсе:"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:183
#: taklif/templates/taklif/shablonlar/_bolimlar.html:247
msgid "Nusxalandi!"
msgstr "Көчүрүлдү!"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:190
msgid "RSVP — kelasizmi?"
msgstr "RSVP — келесизби?"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:195
msgid "Ismingiz"
msgstr "Атыңыз"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:198
