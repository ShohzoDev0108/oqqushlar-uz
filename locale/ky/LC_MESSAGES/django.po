msgstr "Пикир (милдеттүү эмес)"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:217
msgid "Yuborish"
msgstr "Жөнөтүү"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:223
msgid "Mehmonlar"
msgstr "Коноктор"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:224
#, python-format
msgid "Hozircha <strong>%(soni)s</strong> kishi kelishini tasdiqladi"
msgstr "Азырынча <strong>%(soni)s</strong> адам келерин тастыктады"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:228
#, python-format
msgid "%(soni)s kishi"
msgstr "%(soni)s адам"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:237
msgid "Yangiliklar va suratlar uchun Telegram guruhimizga qo'shiling"
msgstr "Жаңылыктар жана сүрөттөр үчүн Telegram тобубузга кошулуңуз"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:238
msgid "Telegram guruhi"
msgstr "Telegram тобу"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:244
msgid "Do'stlaringizga ulashing"
msgstr "Достор менен бөлүшүңүз"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:246
msgid "Taklifnomani yaqinlaringizga ham yuboring"
msgstr "Чакырууну жакындарыңызга да жөнөтүңүз"

#: taklif/templates/taklif/shablonlar/_bolimlar.html:252
msgid "Havolani nusxalash"
msgstr "Шилтемени көчүрүү"

#: taklif/templates/taklif/shablonlar/_konvert_parda.html:12
#, python-format
msgid "Hurmatli %(ism)s, sizga taklifnoma keldi"
msgstr "Урматтуу %(ism)s, сизге чакыруу келди"

#: taklif/templates/taklif/shablonlar/_konvert_parda.html:14
msgid "Sizga taklifnoma keldi"
msgstr "Сизге чакыруу келди"

#: taklif/templates/taklif/shablonlar/_konvert_parda.html:21
msgid "Taklifnomani ochish"
msgstr "Чакырууну ачуу"

#: taklif/templates/taklif/shablonlar/_mijoz_qismi.html:12
msgid "Bu — sizning shaxsiy oldindan ko'rish havolangiz, hali ommaviy emas."
msgstr ""
"Бул — сиздин жеке алдын ала көрүү шилтемеңиз, ал азырынча жалпыга ачык эмес."

#: taklif/templates/taklif/shablonlar/_mijoz_qismi.html:13
msgid "Faollashtirish uchun Telegram orqali"
msgstr "Активдештирүү үчүн Telegram аркылуу"

#: taklif/templates/taklif/shablonlar/_mijoz_qismi.html:15
msgid "bilan bog'laning."
msgstr "байланышыңыз."

