msgid "Taklifnomani yaratish"
msgstr "Чакырууну түзүү"

msgid "Boshqa shablon tanlash"
msgstr "Башка шаблон тандоо"

#, python-format
msgid ""
"Eng ko'pi bilan %(soni)s ta rasm tanlashingiz mumkin. Iltimos, qaytadan "
"tanlang."
msgstr "Эң көбү %(soni)s сүрөт тандай аласыз. Кайра тандаңыз."

#, python-format
msgid ""
"Fayl hajmi %(maks)s MB dan katta bo'lmasligi kerak (yuklangan fayl: "
"%(hajm).1f MB)."
msgstr ""
"Файл көлөмү %(maks)s МБдан ашпашы керек (жүктөлгөн файл: %(hajm).1f МБ)."

#, python-format
msgid ""
"\"%(nomi)s\" fayli juda katta (%(hajm).1f MB). Rasm hajmi %(maks)s MB dan "
"oshmasligi kerak."
msgstr ""
"\"%(nomi)s\" файлы өтө чоң (%(hajm).1f МБ). Сүрөттүн көлөмү %(maks)s МБдан "
"ашпашы керек."

msgid "Iltimos, ismingizni kiriting."
msgstr "Атыңызды киргизиңиз."

msgid "Javobingiz uchun rahmat!"
msgstr "Жообуңуз үчүн рахмат!"

msgid "Bu taklifnomani o'chira olmaysiz."
msgstr "Сиз бул чакырууну өчүрө албайсыз."

#, python-format
msgid ""
"\"%(nomi)s\" taklifnomasi o'chirildi. Bu faollashtirilgan taklifnoma "
"bo'lgani uchun ma'lumotlari %(kun)s kun davomida saqlanadi — agar xato "
"bosgan bo'lsangiz, administratorga murojaat qiling."
msgstr ""
"\"%(nomi)s\" чакыруусу өчүрүлдү. Бул иштетилген чакыруу болгондуктан, "
"маалыматтары %(kun)s күн бою сакталат — ката басып алсаңыз, администраторго "
"кайрылыңыз."

#, python-format
msgid "\"%(nomi)s\" taklifnomasi o'chirildi."
msgstr "\"%(nomi)s\" чакыруусу өчүрүлдү."

msgid "Iltimos, mehmon ismini kiriting."
msgstr "Конокттун атын киргизиңиз."

#, python-format
msgid "\"%(ism)s\" uchun shaxsiy link yaratildi."
msgstr "\"%(ism)s\" үчүн жеке шилтеме түзүлдү."

msgid "Mehmon o'chirildi."
msgstr "Конок өчүрүлдү."

msgid "Tilak endi taklifnoma sahifasida hammaga ko'rinadi."
msgstr "Каалоо эми чакыруу баракчасында баарына көрүнөт."

msgid "Tilak yashirildi — endi faqat sizga ko'rinadi."
msgstr "Каалоо жашырылды — эми сизге гана көрүнөт."

msgid "Sahifa topilmadi"
msgstr "Барак табылган жок"

msgid "Bunday sahifa topilmadi"
msgstr "Мындай барак табылган жок"

msgid "Havola noto'g'ri yoki bu sahifa endi mavjud emas."
msgstr "Шилтеме туура эмес же бул барак мындан ары жок."

msgid "Bosh sahifaga qaytish"
msgstr "Башкы бетке кайтуу"

msgid "Xatolik yuz berdi"
msgstr "Ката кетти"

msgid "Kechirasiz, xatolik yuz berdi"
msgstr "Кечиресиз, ката кетти"

msgid ""
"Sahifa vaqtincha ishlamayapti. Iltimos, birozdan so'ng qayta urinib ko'ring."
msgstr ""
"Барак убактылуу иштебей жатат. Бир аздан кийин кайра аракет кылып көрүңүз."

msgid "Django site admin"
msgstr "Django сайт башкаруусу"

msgid "Django administration"
msgstr "Django башкаруусу"

#, python-format
msgid "Sizni %(sana)s kunidagi marosimimizga taklif qilamiz"
msgstr "Сизди %(sana)s күнкү тоюбузга чакырабыз"

msgid "Oqqushlar — chiroyli elektron taklifnomalar"
msgstr "Oqqushlar — сулуу электрондук чакыруу кагаздары"

msgid ""
"O'zbekiston uchun eng chiroyli va zamonaviy elektron taklifnomalar. Bir "
"necha daqiqada yarating."
msgstr ""
"Өзбекстан үчүн эң сулуу жана заманбап электрондук чакыруу кагаздары. Бир "
"нече мүнөттө түзүңүз."
