msgstr "чакыруусу"

msgid "Statistika"
msgstr "Статистика"

msgid "Ochiq sahifani ko'rish"
msgstr "Чакырууну көрүү"

#, python-format
msgid "%(nomi)s — statistika"
msgstr "%(nomi)s — статистика"

msgid "Bu sahifa faqat sizga ko'rinadi. Linkni hech kimga yubormang."
msgstr "Бул бет сизге гана көрүнөт. Шилтемени эч кимге жибербеңиз."

msgid "ko'rishlar"
msgstr "көрүүлөр"

msgid "javoblar"
msgstr "жооптор"

msgid "keladi (mehmon)"
msgstr "келет (конок)"

msgid "kelmaydi"
msgstr "келбейт"

msgid "Ism"
msgstr "Аты"

msgid "Holat"
msgstr "Абалы"

msgid "Mehmonlar soni"
msgstr "Коноктор саны"

msgid "Izoh"
msgstr "Пикир"

msgid "Keladi"
msgstr "Келет"

msgid "Kelmaydi"
msgstr "Келбейт"

msgid "Hozircha javoblar yo'q."
msgstr "Азырынча жооп жок."

msgid "Mehmonlar uchun shaxsiy linklar"
msgstr "Коноктор үчүн жеке шилтемелер"

msgid ""
"Admin panelda qo'shilgan har bir mehmonga shaxsiy link — shu linkni "
"Telegram/Instagram orqali o'sha mehmonning o'ziga yuboring."
msgstr ""
"Админ панелинде кошулган ар бир конокко жеке шилтеме — бул шилтемени "
"Telegram/Instagram аркылуу ошол коноктун өзүнө жибериңиз."

msgid "Ko'rdimi"
msgstr "Көрдүбү?"

msgid "Link"
msgstr "Шилтеме"

msgid "ko'rdi"
msgstr "көрдү"

msgid "hali ko'rmagan"
msgstr "азырынча көрө элек"

msgid ""
"Hali mehmon qo'shilmagan. Admin panelda taklifnoma ichida \"Mehmonlar\" "
"bo'limidan qo'shing."
msgstr ""
"Азырынча конок кошулган эмес. Аларды админ панелиндеги чакыруунун ичиндеги "
"«Коноктор» бөлүмүнөн кошуңуз."

msgid "Tayyor!"
msgstr "Даяр!"

msgid "Taklifnomangiz tayyor!"
msgstr "Чакырууңуз даяр!"

msgid "Bu — sizning shaxsiy havolangiz. Mehmonlaringizga shuni yuborasiz:"
msgstr "Бул — сиздин жеке шилтемеңиз. Аны конокторуңузга жөнөтүңүз:"

msgid "Nusxalash"
msgstr "Көчүрүү"

msgid "Taklifnomani ko'rish"
msgstr "Чакырууну көрүү"

msgid ""
"Yuqoridagi tugma orqali taklifnomangizni ko'rib, hammasi to'g'ri ekanligiga "
"ishonch hosil qiling."
msgstr ""
"Жогорудагы баскыч аркылуу чакырууңузду көрүп, баары туура экенине ынаныңыз."

#, python-format
msgid ""
"Yoqsa — taklifnoma sahifasidagi <strong>\"Yoqdi\"</strong> tugmasini bosing,"
" shu orqali to'g'ridan-to'g'ri Telegram orqali <strong>%(admin)s</strong> "
"bilan bog'lanib to'lovni amalga oshirasiz."
msgstr ""
"Жакса — чакыруу барагындагы <strong>«Жакты»</strong> баскычын басыңыз: "
"ошентип Telegram аркылуу түз <strong>%(admin)s</strong> менен байланышып, "
"төлөм жасайсыз."

msgid ""
"To'lov tasdiqlangach, taklifnomangiz faollashtiriladi va uni "
"mehmonlaringizga (Telegram, Instagram va h.k.) yuborishingiz mumkin bo'ladi."
msgstr ""
"Төлөм тастыкталгандан кийин чакырууңуз активдештирилет жана аны конокторго "
"жөнөтө аласыз (Telegram, Instagram ж.б.)."

msgid "shabloni"
msgstr "шаблону"

msgid ""
"Ma'lumotlaringizni to'ldiring. Yuborgach — taklifnomangiz shu zahoti tayyor "
"bo'ladi (hali hech kimga ochiq emas)."
msgstr ""
"Маалыматтарыңызды толтуруңуз. Жөнөткөндөн кийин чакыруу кагазыңыз дароо даяр"
" болот (азырынча эч кимге көрүнбөйт)."

#, python-format
msgid ""
"Sizda <strong>%(ism1)s %(ism2)s</strong> nomi bilan taklifnoma allaqachon "
"bor (shu brauzerda avval yaratilgan)."
msgstr ""
"Сизде <strong>%(ism1)s %(ism2)s</strong> аты менен чакыруу кагазы бар экен "
"(мурда ушул браузерде түзүлгөн)."

msgid "Nima qilamiz?"
msgstr "Эмне кылабыз?"

msgid "Buni yangilayman (eskisi o'chadi)"
msgstr "Муну жаңыртам (эскиси өчөт)"

msgid "Yo'q, alohida saqlayman"
msgstr "Жок, өзүнчө сактайм"

#, python-format
msgid "Rasmlar (eng ko'pi bilan %(soni)s ta, ixtiyoriy)"
msgstr "Сүрөттөр (эң көбү %(soni)s даана, милдеттүү эмес)"

msgid "O'z fotoyingiz hali bo'lmasa, tayyor namunalardan tanlashingiz mumkin:"
msgstr ""
"Эгер өзүңүздүн сүрөтүңүз азырынча жок болсо, даяр үлгүлөрдөн тандай аласыз:"

#, python-format
msgid "Namuna rasm %(soni)s"
msgstr "Үлгү сүрөт %(soni)s"

msgid "yoki"
msgstr "же"

msgid "O'zingizning rasmingizni yuklang"
msgstr "Өз сүрөтүңүздү жүктөңүз"

msgid "Taklifnomani yaratish"
msgstr "Чакырууну түзүү"

msgid "Boshqa shablon tanlash"
msgstr "Башка шаблон тандоо"

#, python-format
msgid ""
"Eng ko'pi bilan %(soni)s ta rasm tanlashingiz mumkin. Iltimos, qaytadan "
"tanlang."
msgstr "Эң көбү %(soni)s сүрөт тандай аласыз. Кайра тандаңыз."

#, python-format
msgid ""
"Fayl hajmi %(maks)s MB dan katta bo'lmasligi kerak (yuklangan fayl: "
"%(hajm).1f MB)."
msgstr ""
"Файл көлөмү %(maks)s МБдан ашпашы керек (жүктөлгөн файл: %(hajm).1f МБ)."

#, python-format
msgid ""
"\"%(nomi)s\" fayli juda katta (%(hajm).1f MB). Rasm hajmi %(maks)s MB dan "
"oshmasligi kerak."
msgstr ""
"\"%(nomi)s\" файлы өтө чоң (%(hajm).1f МБ). Сүрөттүн көлөмү %(maks)s МБдан "
"ашпашы керек."

msgid "Iltimos, ismingizni kiriting."
msgstr "Атыңызды киргизиңиз."

msgid "Javobingiz uchun rahmat!"
msgstr "Жообуңуз үчүн рахмат!"

msgid "Bu taklifnomani o'chira olmaysiz."
msgstr "Сиз бул чакырууну өчүрө албайсыз."

#, python-format
msgid ""
"\"%(nomi)s\" taklifnomasi o'chirildi. Bu faollashtirilgan taklifnoma "
"bo'lgani uchun ma'lumotlari %(kun)s kun davomida saqlanadi — agar xato "
"bosgan bo'lsangiz, administratorga murojaat qiling."
msgstr ""
"\"%(nomi)s\" чакыруусу өчүрүлдү. Бул иштетилген чакыруу болгондуктан, "
"маалыматтары %(kun)s күн бою сакталат — ката басып алсаңыз, администраторго "
"кайрылыңыз."

#, python-format
msgid "\"%(nomi)s\" taklifnomasi o'chirildi."
msgstr "\"%(nomi)s\" чакыруусу өчүрүлдү."

msgid "Sahifa topilmadi"
msgstr "Барак табылган жок"

msgid "Bunday sahifa topilmadi"
msgstr "Мындай барак табылган жок"

msgid "Havola noto'g'ri yoki bu sahifa endi mavjud emas."
msgstr "Шилтеме туура эмес же бул барак мындан ары жок."

msgid "Bosh sahifaga qaytish"
msgstr "Башкы бетке кайтуу"

msgid "Xatolik yuz berdi"
msgstr "Ката кетти"

msgid "Kechirasiz, xatolik yuz berdi"
msgstr "Кечиресиз, ката кетти"

msgid ""
"Sahifa vaqtincha ishlamayapti. Iltimos, birozdan so'ng qayta urinib ko'ring."
msgstr ""
"Барак убактылуу иштебей жатат. Бир аздан кийин кайра аракет кылып көрүңүз."

#, python-format
msgid "Sizni %(sana)s kunidagi marosimimizga taklif qilamiz"
msgstr "Сизди %(sana)s күнкү тоюбузга чакырабыз"

msgid "Oqqushlar — chiroyli elektron taklifnomalar"
msgstr "Oqqushlar — сулуу электрондук чакыруу кагаздары"

msgid ""
"O'zbekiston uchun eng chiroyli va zamonaviy elektron taklifnomalar. Bir "
"necha daqiqada yarating."
msgstr ""
"Өзбекстан үчүн эң сулуу жана заманбап электрондук чакыруу кагаздары. Бир "
"нече мүнөттө түзүңүз."

