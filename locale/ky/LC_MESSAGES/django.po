msgstr "— тандалган жок —"

msgid "Masalan: Do'kon ochilishi, Bitiruv kechasi"
msgstr "Мисалы: Дүкөн ачылышы, Бүтүрүүчүлөр кечеси"

msgid "Masalan: “Poytaxt” to'yxonasi"
msgstr "Мисалы: «Пойтахт» той залы"

msgid "Masalan: Toshkent sh., Chilonzor tumani, Bunyodkor ko'chasi 12"
msgstr "Мисалы: Ташкент ш., Чиланзар району, Бунёдкор көчөсү 12"

msgid "Masalan: rasmiy kiyim, och ranglar"
msgstr "Мисалы: расмий кийим, ачык түстөр"

msgid ""
"Masalan: Sizlarsiz bu kun to'liq bo'lmaydi — quvonchimizga sherik "
"bo'lishingizni astoydil kutamiz"
msgstr ""
"Мисалы: Бул күн силерсиз толук болбойт — кубанычыбызга шерик болушуңарды чын"
" жүрөктөн күтөбүз"

msgid "Tadbir nomi"
msgstr "Иш-чаранын аталышы"

msgid "Tadbir sanasi va vaqti"
msgstr "Иш-чара күнү жана убактысы"

msgid "To'yxona/manzil nomi"
msgstr "Той залы/жердин аталышы"

msgid "Manzil"
msgstr "Дареги"

msgid "Xarita havolasi (ixtiyoriy)"
msgstr "Карта шилтемеси (милдеттүү эмес)"

msgid "Kiyinish kodi (ixtiyoriy)"
msgstr "Кийим коду (милдеттүү эмес)"

msgid "O'zingiz musiqa yuklash (ixtiyoriy)"
msgstr "Өз музыкаңызды жүктөө (милдеттүү эмес)"

msgid "Mehmonlarga atalgan so'zingiz (ixtiyoriy)"
msgstr "Конокторго арналган сөзүңүз (милдеттүү эмес)"

msgid "Sovg'a-pul uchun karta raqami (ixtiyoriy)"
msgstr "Акчалай белекке карта номери (милдеттүү эмес)"

msgid "Mehmonlar uchun Telegram guruhi (ixtiyoriy)"
msgstr "Коноктор үчүн Telegram тобу (милдеттүү эмес)"

msgid ""
"Taklifnomangiz sayt bosh sahifasida namuna sifatida boshqa mijozlarga "
"ko'rsatilishiga rozimisiz?"
msgstr ""
"Чакырууңуздун сайттын башкы бетинде башка кардарларга үлгү катары "
"көрсөтүлүшүнө макулсузбу?"

msgid "Marosim turini ro'yxatda topa olmasangiz shu yerga o'zingiz yozing."
msgstr "Иш-чаранын түрүн тизмеден таба албасаңыз, бул жерге өзүңүз жазыңыз."

msgid "Taklifnomada mehmonlarga to'g'ridan-to'g'ri shu matn ko'rsatiladi."
msgstr "Бул текст чакырууда конокторго түз көрсөтүлөт."

msgid "O'zingiz yuklamoqchi bo'lsangiz"
msgstr "Өз файлыңызды жүктөгүңүз келсе"

#| msgid ""
#| "Ixtiyoriy. Yoqmasangiz ham taklifnomangiz odatdagidek ishlayveradi — bu "
#| "faqat bosh sahifadagi namunalar ro'yxatiga tegishli."
msgid ""
"Ixtiyoriy. Belgilamasangiz ham taklifnomangiz odatdagidek ishlayveradi — bu "
"faqat bosh sahifadagi namunalar ro'yxatiga tegishli."
msgstr ""
"Милдеттүү эмес. Белгилебесеңиз да, чакырууңуз адаттагыдай иштей берет — бул "
"башкы беттеги үлгүлөр тизмесине гана тиешелүү."

msgid "Bu marosim turi uchun ikkinchi ismni ham kiriting."
msgstr "Бул иш-чара түрү үчүн экинчи ысымды да киргизиңиз."

