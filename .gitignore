# Virtual muhitlar
venv/
.venv/
env/
ENV/

# Python
__pycache__/
*.py[cod]
*$py.class

# Maxfiy sozlamalar — HECH QACHON commit qilinmasin
.env
.env.*
!.env.example

# Ma'lumotlar bazasi (haqiqiy mijoz ma'lumotlari bo'lishi mumkin)
db.sqlite3
db.sqlite3-journal
*.sqlite3

# Foydalanuvchi yuklagan fayllar (rasm/musiqa) — bular haqiqiy mijoz
# ma'lumotlari, shuning uchun git'ga tushmaydi.
# ("media/" ni butunlay yopib qo'yish MUMKIN EMAS — git ignored papka ichiga
# umuman kirmaydi, shuning uchun pastdagi "!" qoidalar ishlamay qoladi.)
media/musiqa/
media/taklifnoma_rasmlar/

# ...lekin quyidagilar mijoz yuklamasi emas — ilova o'zi bilan olib yuradigan
# tayyor namunalar (migratsiya shu fayl nomlarini kutubxonaga yozadi),
# shuning uchun git'da saqlanishi kerak.
!media/namuna_rasmlar/
!media/namuna_rasmlar/**
!media/shablonlar/
!media/shablonlar/**

# Statik fayllar (collectstatic natijasi)
staticfiles/
static_root/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Loglar
*.log

# Ish jarayonidagi ekran suratlari va vaqtinchalik fayllar — loyihaning
# o'ziga tegishli emas, lekin har commitda "untracked" bo'lib ko'zga
# tashlanib turardi.
Claude outputs/
sinov_sozlamalari.py
