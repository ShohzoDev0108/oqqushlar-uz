# Bu faylni nusxalab ".env" nomi bilan saqlang va o'z qiymatlaringizni kiriting:
#   cp .env.example .env        (Linux/Mac)
#   copy .env.example .env      (Windows)
#
# ".env" fayli hech qachon Git'ga qo'shilmaydi (.gitignore'da) — u faqat
# shu kompyuter yoki serverda qoladi. Bu yerdagi ".env.example" esa
# namuna sifatida GitHub'ga qo'yiladi, ichida haqiqiy maxfiy qiymat yo'q.

# Django maxfiy kaliti — production'da MAJBURIY, tasodifiy va uzun bo'lishi kerak.
# Yangi kalit generatsiya qilish uchun:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Lokal kompyuterda ishlaganda True, haqiqiy serverda albatta False qiling.
DJANGO_DEBUG=True

# Vergul bilan ajratib, saytga ruxsat berilgan domen/IP'larni yozing.
# Masalan: taklifnoma365.uz,www.taklifnoma365.uz,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Agar saytga admin panel yoki forma boshqa domendan (https) yuborilsa kerak
# bo'ladi. Masalan: https://taklifnoma365.uz,https://www.taklifnoma365.uz
DJANGO_CSRF_TRUSTED_ORIGINS=

# Faqat production serverda (DEBUG=False) qo'llaniladi:
# Agar sayt nginx/caddy kabi teskari-proksi orqasida bo'lsa va HTTPS'ni
# proksi tugatsa, buni 1 qiling — aks holda redirect tsikliga tushishi mumkin.
DJANGO_BEHIND_PROXY=0

# Mijozga "to'lov qilish uchun bog'laning" deb ko'rsatiladigan Telegram username.
SAYT_ADMIN_TELEGRAM=@taklifnoma365_admin

# Google Analytics 4 o'lchov ID'si (masalan: G-ABC1234XYZ).
# Google Analytics'da yaratgan "property"ingizning ID'sini shu yerga yozing.
# Bo'sh qoldirilsa, sayt GA skriptini umuman yuklamaydi.
GOOGLE_ANALYTICS_ID=

# --- Ma'lumotlar bazasi (production) ---
# Lokal kompyuterda BO'SH qoldiring — shunda avtomatik oddiy SQLite fayl
# ishlatiladi (hech narsa o'rnatish shart emas). Haqiqiy serverda (Render
# va h.k.) buni PostgreSQL'ning ulanish manzili bilan to'ldirasiz — Render'da
# bu maydon ma'lumotlar bazasi yaratilganda AVTOMATIK to'ldiriladi, qo'lda
# yozish shart emas.
# Format: postgres://foydalanuvchi:parol@host:5432/bazanomi
DATABASE_URL=

# --- Mijoz yuklagan fayllar uchun tashqi xotira (production) ---
# MUHIM: Render/Railway kabi platformalarda serverning ichki diski har
# deploy'da tozalanadi — shuning uchun production'da mijozlar yuklagan
# taklifnoma rasmlarini serverning o'zida EMAS, tashqi doimiy xotirada
# (masalan Cloudflare R2 — juda arzon/deyarli tekin) saqlash SHART, aks
# holda to'lab faollashtirilgan taklifnomalarning rasmlari keyingi
# yangilanishda yo'qolib qolishi mumkin.
#
# Lokal kompyuterda ishlaganda USE_S3=0 qoldiring (yoki umuman yozmang) —
# shunda rasmlar oddiy "media/" jildiga saqlanadi, hech narsa sozlash shart
# emas. Production serverda USE_S3=1 qilib, quyidagilarni to'ldiring.
USE_S3=0

# Cloudflare R2 (yoki boshqa S3-mos xizmat) hisobingizdan olinadi.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=

# Cloudflare R2 uchun: https://<hisob-ID>.r2.cloudflarestorage.com
# (Haqiqiy Amazon S3 ishlatilsa, bu qatorni bo'sh qoldiring.)
AWS_S3_ENDPOINT_URL=

# Ixtiyoriy: agar R2/S3 bucket'ingizga o'zingizning domeningizni (masalan
# fayllar.taklifnoma365.uz) ulagan bo'lsangiz, shu yerga yozing — aks holda
# bo'sh qoldiring, xizmatning o'z manzili ishlatiladi.
AWS_S3_CUSTOM_DOMAIN=
