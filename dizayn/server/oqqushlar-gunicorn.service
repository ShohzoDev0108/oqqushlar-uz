# Gunicorn (WSGI ilova serveri) xizmati — Django ilovasini 127.0.0.1:8000
# portida ishga tushiradi, nginx undan proxy_pass orqali so'rov uzatadi.
#
# O'RNATISH (serverda, root sifatida):
#   cp dizayn/server/oqqushlar-gunicorn.service /etc/systemd/system/oqqushlar.service
#   systemctl daemon-reload
#   systemctl enable --now oqqushlar.service
#
# Qo'lda qayta ishga tushirish:  systemctl restart oqqushlar
# Jurnalni ko'rish:              journalctl -u oqqushlar -n 50
#
# ESLATMA (2026-09-15, 49-band): bu fayl serverda HOZIR ishlab turgan
# haqiqiy konfiguratsiyaning nusxasi — `systemctl cat oqqushlar.service`
# orqali olingan, qo'lda qayta yozilmagan. Xizmat nomi serverda
# "oqqushlar.service" — nusxalashda ham shu nom saqlansin (fayl nomi
# repoda "oqqushlar-gunicorn.service" bo'lsa ham).
#
# KUZATILGAN, LEKIN BU BANDDA ATAYLAB TUZATILMAGAN: --log-file
# /opt/oqqushlar/gunicorn.log fayliga to'g'ridan-to'g'ri yozadi — log
# aylantirilmaydi (logrotate sozlanmagan bo'lsa, vaqt o'tib fayl cheksiz
# o'sishi mumkin). Bu 30 bandlik taftish ro'yxatiga kirmagan, alohida
# ko'rib chiqilishi kerak.

[Unit]
Description=Oqqushlar Gunicorn daemon
After=network.target postgresql.service

[Service]
User=deploy
Group=deploy
WorkingDirectory=/opt/oqqushlar
ExecStart=/opt/oqqushlar/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --log-file /opt/oqqushlar/gunicorn.log
Restart=always

[Install]
WantedBy=multi-user.target
