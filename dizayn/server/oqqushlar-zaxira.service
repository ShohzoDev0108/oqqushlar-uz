# Bazaning shifrlangan zaxira nusxasini olib R2'ga yuboradi.
#
# O'RNATISH (serverda, root sifatida):
#   cp dizayn/server/oqqushlar-zaxira.* /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now oqqushlar-zaxira.timer
#
# Qo'lda ishga tushirish:  systemctl start oqqushlar-zaxira.service
# Jurnalni ko'rish:        journalctl -u oqqushlar-zaxira -n 50
#
# TAFTISH TOPILMASI (2026-09-14): bu xizmat ilgari ROOT sifatida ishlardi,
# lekin zaxira buyrug'ining o'ziga root huquqi umuman kerak emas — bazaga
# parol bilan TCP orqali ulanadi, R2'ga tarmoq orqali yuboradi, natija esa
# faqat pastdagi PrivateTmp papkasiga yoziladi. Endi ALOHIDA, imtiyozsiz
# foydalanuvchi ostida ishlaydi. Bu foydalanuvchi xizmatni joylashtirishdan
# OLDIN, serverda BIR MARTA (root sifatida) shunday yaratiladi:
#
#   useradd --system --no-create-home --shell /usr/sbin/nologin oqqushlar-zaxira
#   setfacl -R -m u:oqqushlar-zaxira:rX /opt/oqqushlar
#   setfacl -R -d -m u:oqqushlar-zaxira:rX /opt/oqqushlar
#
# ACL orqali FAQAT o'qish va papkalarga kirish huquqi beriladi — yozish
# huquqi yo'q, chunki bu foydalanuvchiga umuman kerak emas.

[Unit]
Description=Oqqushlar bazasining zaxira nusxasi
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=oqqushlar-zaxira
Group=oqqushlar-zaxira
WorkingDirectory=/opt/oqqushlar
ExecStart=/opt/oqqushlar/venv/bin/python manage.py zaxira

# Zaxira olish uzoq davom etishi mumkin, lekin cheksiz emas — osilib
# qolgan jarayon keyingi kungi ishga xalaqit bermasin.
TimeoutStartSec=1800

# Nusxa vaqtinchalik faylga yoziladi; u shu xizmatga xos, alohida
# papkada bo'lsin va ish tugashi bilan avtomatik o'chsin.
PrivateTmp=true
NoNewPrivileges=true
